      "raw": "{\"decision\":\"ask\",\"rule\":\"r\"}",
      "decision": "ask"
    },
    {
      "why": "whitespace between tokens is JSON, not a second grammar",
      "raw": "{ \"decision\" : \"ask\" , \"rule\" : \"r\" }",
      "decision": "ask"
    },
    {
      "why": "key order is not part of the grammar",
      "raw": "{\"rule\":\"r\",\"decision\":\"deny\"}",
      "decision": "deny"
    },
    {
      "why": "a repeated `decision` is the whole reason this grammar is strict: Elixir's decoder takes the first and serde_json takes the last, so two readers of one document disagreed about what a component said",
