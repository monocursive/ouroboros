[Unit]
Description=Ouroboros runtime for /home/tester/.ouroboros
# No network ordering: `ouro service-run` waits for this machine's own private
# interface to become bindable before it launches the BEAM, and reports that wait
# in this unit's log. A user manager has no network-online.target to want.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart="/usr/local/bin/ouro" service-run
WorkingDirectory=/home/tester/.ouroboros
Environment=HOME="/home/tester"
Environment=OUROBOROS_DATA_DIR="/home/tester/.ouroboros"
Environment=PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/home/tester/.ouroboros/service.out.log
StandardError=append:/home/tester/.ouroboros/service.err.log

[Install]
WantedBy=default.target
