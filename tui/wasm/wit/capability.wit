// Lane W's world, as the artifact a guest binds against (docs/WASM.md §7.1).
//
// `tui/wasm/src/world.rs` hard-codes this same shape, because the helper must be able to
// refuse bytes without a WIT parser on the loading path; this file is what a guest author
// compiles against, and `test/wasm/capability_acceptance_test.exs` cross-checks the two by
// asking `inspect` what a component built from this file actually declares.
//
// Exactly one import. A capability can compute, keep its own state between messages, and say
// something into the daemon's log. It cannot read a clock, see a filesystem, open a socket, or
// learn anything about the host it did not arrive knowing — and an import the host does not
// define fails to link, which is the whole containment claim (D5).

package ouroboros:capability@0.1.0;

world capability {
  /// JSON metadata: name, version, declared eval hints. Pure.
  export describe: func() -> string;
  /// Called once per instance with host-supplied JSON config.
  export init: func(config: string) -> result<_, string>;
  /// One mesh message in, one reply out. JSON both ways. State is instance-held.
  export handle-message: func(body: string) -> result<string, string>;
  /// Log line into the daemon's logger. The only import in v1.
  import log: func(level: string, message: string);
}
