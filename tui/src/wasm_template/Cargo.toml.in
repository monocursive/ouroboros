# A capability component for Ouroboros lane W, in world ouroboros:capability@0.1.0.
#
# Its own workspace on purpose: an empty `[workspace]` table stops cargo walking up the tree, so
# dropping this project inside a larger repository cannot pull it into that repository's graph
# or give it that repository's profile, features or lockfile.
[workspace]

[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
# `wasm32-wasip2` emits a component directly from `cargo build` on 1.82 and later, which is what
# keeps this a plain `cargo build` rather than a `cargo component` toolchain.
rust-version = "1.82"
publish = false

[lib]
# A component's core module is a cdylib with no `_start`: the world's exports are its entry
# points and there is nothing else to run.
crate-type = ["cdylib"]

[dependencies]
# The bindings generator for the world in `wit/`. `default-features = false` plus exactly what
# the world needs. What that drops is `std` — see the `no_std` note in src/lib.rs; a `std` build
# of this same source imports thirteen `wasi:cli`/`wasi:io` interfaces, and the helper's linker
# defines none of them — plus `async` (this world is synchronous) and `bitflags` (no flags type).
wit-bindgen = { version = "0.57", default-features = false, features = [
  "macros",
  "realloc",
] }
# JSON in and JSON out is this world's contract, so parse rather than splice: a body you cannot
# read is an `err(string)` the host records, never a trap and never a reply that is not JSON.
serde_json = { version = "1", default-features = false, features = ["alloc"] }
# The allocator a `no_std` build has to bring itself. This is the same implementation Rust's
# standard library uses on wasm targets, so choosing it is choosing what a `std` build would
# have linked anyway — without the WASI imports that came with it.
dlmalloc = { version = "0.2", features = ["global"] }

[profile.release]
# `panic = "abort"` keeps the unwinder — and everything it drags in — out of the component. A
# panic in a guest is a trap the host already classifies; there is nothing here to unwind to.
# LTO and a size-shaped opt level then let the linker drop what is unreachable, which is what
# keeps the import list at exactly `log`.
panic = "abort"
lto = true
opt-level = "s"
strip = true
codegen-units = 1
