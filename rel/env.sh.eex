#!/bin/sh
# Ouroboros release environment, sourced by bin/<%= @release.name %> before every command.
#
# There are two postures and the environment picks between them.
#
# A node that is told nothing — no OUROBOROS_NODE, no OUROBOROS_CLUSTER_STRATEGY, no
# OUROBOROS_DIST — is a single-machine daemon: no epmd and no distribution listener, so
# no cookie is reachable on the network. The release launcher itself always wants a boot
# cookie, even in that posture; below we replace the artifact's shared releases/COOKIE
# with a fresh disposable value on every start. A fleet replaces that value from its
# private cookie file before formation begins.
#
# Naming this node, or asking it to join a cluster, or setting OUROBOROS_DIST to anything
# other than none, selects the other posture: distribution with long names, because the
# mesh addresses nodes as name@host and the cluster strategies in Ouroboros.Cluster hand
# libcluster fully qualified names. That posture requires both a name and a cookie and
# refuses the boot without them.
if [ "$OUROBOROS_DIST" = "none" ]; then
  export RELEASE_DISTRIBUTION=none
elif [ -n "$OUROBOROS_DIST" ] || [ -n "$OUROBOROS_NODE" ]; then
  export RELEASE_DISTRIBUTION=name
else
  case "$OUROBOROS_CLUSTER_STRATEGY" in
    "" | none) export RELEASE_DISTRIBUTION=none ;;
    *) export RELEASE_DISTRIBUTION=name ;;
  esac
fi

case "$RELEASE_COMMAND" in
  version | "")
    # Neither prints nor starts a node, so neither needs an identity.
    ;;

  *)
    # Never let the generated release launcher fall back to releases/COOKIE. That file is
    # part of the artifact, so every machine extracting the same binary would otherwise
    # expose the same value in its process arguments even in standalone mode.
    if [ -n "$OUROBOROS_BOOT_COOKIE_DECOY" ]; then
      case "$OUROBOROS_BOOT_COOKIE_DECOY" in
        *[!A-Za-z0-9_]*)
          echo "ERROR: OUROBOROS_BOOT_COOKIE_DECOY must contain only letters, numbers, and underscores" >&2
          exit 1
          ;;
      esac
      RELEASE_COOKIE="$OUROBOROS_BOOT_COOKIE_DECOY"
    else
      if [ ! -r /dev/urandom ] || ! command -v od >/dev/null 2>&1 || ! command -v tr >/dev/null 2>&1; then
        echo "ERROR: cannot generate a disposable release boot cookie (/dev/urandom, od, and tr are required)" >&2
        exit 1
      fi
      ouro_boot_random="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
      case "$ouro_boot_random" in
        *[!0-9a-f]* | "")
          echo "ERROR: operating-system randomness did not produce a valid release boot cookie" >&2
          exit 1
          ;;
      esac
      if [ "${#ouro_boot_random}" -ne 64 ]; then
        echo "ERROR: operating-system randomness returned a short release boot cookie" >&2
        exit 1
      fi
      RELEASE_COOKIE="ouro_boot_$ouro_boot_random"
      unset ouro_boot_random
    fi
    export RELEASE_COOKIE

    if [ "$RELEASE_DISTRIBUTION" = "none" ]; then
      # Clustering *is* distribution. Accepting both would mean either starting the
      # listener the operator asked to have off, or leaving a strategy that can never
      # form a cluster looking configured; both variables are named in the error because
      # either one may be the mistake. Only an explicit OUROBOROS_DIST=none reaches this:
      # a cluster strategy on its own takes the distributed branch above.
      case "$OUROBOROS_CLUSTER_STRATEGY" in
        "" | none) ;;
        *)
          echo "ERROR: OUROBOROS_DIST=none disables distribution, but OUROBOROS_CLUSTER_STRATEGY=$OUROBOROS_CLUSTER_STRATEGY asks this node to join a cluster. Unset one of them." >&2
          exit 1
          ;;
      esac

      # A node that never starts distribution has no name to be given and no secret to
      # share, so OUROBOROS_NODE and OUROBOROS_COOKIE are not required below.
    else
      # Something in the environment asked for distribution, so a blank node name or
      # cookie source is refused here rather than inherited. The release would otherwise
      # fall back to the release name and to the random cookie baked into releases/COOKIE.
      if [ -z "$OUROBOROS_NODE" ]; then
        echo "ERROR: OUROBOROS_NODE must be set to this node's long name, e.g. core-1@10.0.0.11" >&2
        echo "This node was asked for distribution by OUROBOROS_DIST=$OUROBOROS_DIST OUROBOROS_CLUSTER_STRATEGY=$OUROBOROS_CLUSTER_STRATEGY, and a distributed node needs a name and a cookie of its own." >&2
        echo "Leaving OUROBOROS_NODE, OUROBOROS_CLUSTER_STRATEGY, and OUROBOROS_DIST all unset starts a standalone single-machine node instead: no distribution, no epmd, no cookie. \`ouro\` is the interactive client for such a node." >&2
        exit 1
      fi

      case "$OUROBOROS_NODE" in
        *@*) ;;
        *)
          echo "ERROR: OUROBOROS_NODE must be a long name (name@host), got: $OUROBOROS_NODE" >&2
          exit 1
          ;;
      esac

      RELEASE_NODE="$OUROBOROS_NODE"
      export RELEASE_NODE

      if [ -n "$OUROBOROS_COOKIE_FILE" ]; then
        case "$OUROBOROS_COOKIE_FILE" in
          /*) ;;
          *)
            echo "ERROR: OUROBOROS_COOKIE_FILE must be an absolute path" >&2
            exit 1
            ;;
        esac
        if [ -L "$OUROBOROS_COOKIE_FILE" ] || [ ! -f "$OUROBOROS_COOKIE_FILE" ] || [ ! -r "$OUROBOROS_COOKIE_FILE" ]; then
          echo "ERROR: OUROBOROS_COOKIE_FILE must name a readable private regular file, not a symlink" >&2
          exit 1
        fi

        # Mix releases put RELEASE_COOKIE on the emulator command line. Never read the
        # real fleet cookie here: config/runtime.exs validates the private 0600 file and
        # installs it with Node.set_cookie/1 before libcluster starts. This per-boot value
        # is deliberately disposable, so seeing the process argv reveals no fleet secret.
        # RELEASE_COOKIE already holds the fresh per-boot decoy generated above.
      elif [ -n "$OUROBOROS_COOKIE" ]; then
        # Legacy operator-managed releases keep their existing contract. `ouro fleet`
        # never uses this path because an environment cookie can be exposed by process
        # inspection on release launch.
        RELEASE_COOKIE="$OUROBOROS_COOKIE"
      else
        echo "ERROR: distributed nodes need OUROBOROS_COOKIE_FILE (recommended) or legacy OUROBOROS_COOKIE" >&2
        exit 1
      fi
      export RELEASE_COOKIE
    fi
    ;;
esac
