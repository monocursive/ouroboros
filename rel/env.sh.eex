#!/bin/sh
# Ouroboros release environment, sourced by bin/<%= @release.name %> before every command.
#
# There are two postures and the environment picks between them.
#
# A node that is told nothing — no OUROBOROS_NODE, no OUROBOROS_CLUSTER_STRATEGY, no
# OUROBOROS_DIST — is a single-machine daemon: no epmd, no distribution listener, and no
# cookie on the host at all, so there is nothing on the network for a guessed cookie to
# reach. This is the same posture OUROBOROS_DIST=none selects explicitly, and it is the
# default because the alternative fallback is worse: without a name and a cookie of its
# own the release would boot as the release name with the random cookie baked into
# releases/COOKIE at build time, which every host built from the same artifact shares.
#
# Naming this node, or asking it to join a cluster, or setting OUROBOROS_DIST to anything
# other than none, selects the other posture: distribution with long names, because the
# mesh addresses nodes as name@host and the cluster strategies in Ouroboros.Cluster hand
# libcluster fully qualified names. That posture requires both a name and a cookie and
# refuses the boot without them.
if [ "$OUROBOROS_DIST" = "none" ]; then
  export RELEASE_DISTRIBUTION=none
elif [ -n "$OUROBOROS_DIST" ] || [ -n "$OUROBOROS_NODE" ]; then
  export RELEASE_DISTRIBUTION=name
else
  case "$OUROBOROS_CLUSTER_STRATEGY" in
    "" | none) export RELEASE_DISTRIBUTION=none ;;
    *) export RELEASE_DISTRIBUTION=name ;;
  esac
fi

case "$RELEASE_COMMAND" in
  version | "")
    # Neither prints nor starts a node, so neither needs an identity.
    ;;

  *)
    if [ "$RELEASE_DISTRIBUTION" = "none" ]; then
      # Clustering *is* distribution. Accepting both would mean either starting the
      # listener the operator asked to have off, or leaving a strategy that can never
      # form a cluster looking configured; both variables are named in the error because
      # either one may be the mistake. Only an explicit OUROBOROS_DIST=none reaches this:
      # a cluster strategy on its own takes the distributed branch above.
      case "$OUROBOROS_CLUSTER_STRATEGY" in
        "" | none) ;;
        *)
          echo "ERROR: OUROBOROS_DIST=none disables distribution, but OUROBOROS_CLUSTER_STRATEGY=$OUROBOROS_CLUSTER_STRATEGY asks this node to join a cluster. Unset one of them." >&2
          exit 1
          ;;
      esac

      # A node that never starts distribution has no name to be given and no secret to
      # share, so OUROBOROS_NODE and OUROBOROS_COOKIE are not required below.
    else
      # Something in the environment asked for distribution, so a blank node name or
      # cookie is refused here rather than inherited. The release would otherwise fall
      # back to the release name and to the random cookie baked into releases/COOKIE at
      # build time, which means every host built from the same artifact shares a cookie
      # nobody chose and nobody can rotate.
      if [ -z "$OUROBOROS_NODE" ]; then
        echo "ERROR: OUROBOROS_NODE must be set to this node's long name, e.g. core-1@10.0.0.11" >&2
        echo "This node was asked for distribution by OUROBOROS_DIST=$OUROBOROS_DIST OUROBOROS_CLUSTER_STRATEGY=$OUROBOROS_CLUSTER_STRATEGY, and a distributed node needs a name and a cookie of its own." >&2
        echo "Leaving OUROBOROS_NODE, OUROBOROS_CLUSTER_STRATEGY, and OUROBOROS_DIST all unset starts a standalone single-machine node instead: no distribution, no epmd, no cookie. \`ouro\` is the interactive client for such a node." >&2
        exit 1
      fi

      case "$OUROBOROS_NODE" in
        *@*) ;;
        *)
          echo "ERROR: OUROBOROS_NODE must be a long name (name@host), got: $OUROBOROS_NODE" >&2
          exit 1
          ;;
      esac

      if [ -z "$OUROBOROS_COOKIE" ]; then
        echo "ERROR: OUROBOROS_COOKIE must be set to the cluster's shared secret" >&2
        exit 1
      fi

      RELEASE_NODE="$OUROBOROS_NODE"
      export RELEASE_NODE
      RELEASE_COOKIE="$OUROBOROS_COOKIE"
      export RELEASE_COOKIE
    fi
    ;;
esac
