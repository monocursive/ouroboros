---
import '@fontsource-variable/manrope';
import '../styles/global.css';

interface Props { title: string; description: string; markdown?: string; }
const { title, description, markdown } = Astro.props;
const repository = 'https://github.com/monocursive/ouroboros';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d0c" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ouroboros Jail" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={new URL(markdown, Astro.site)} title="Markdown version" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Documentation for agents" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container navigation">
        <a class="brand" href="/" aria-label="Ouroboros Jail home">
          <img src="/brand/ouroboros.svg" width="36" height="36" alt="" />
          <span>ouroboros<span class="brand-suffix"> / jail</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/guide/" aria-current={Astro.url.pathname.startsWith('/guide') ? 'page' : undefined}>Guide</a>
          <a href="/roadmap/" aria-current={Astro.url.pathname.startsWith('/roadmap') ? 'page' : undefined}>Roadmap</a>
          <a class="github-link" href={`${repository}/tree/dev`}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-row">
        <p>An open-source sandbox for AI agents. Currently in development.</p>
        <div><a href={`${repository}/blob/dev/LICENSE`}>MIT license</a><a href="https://monocursive.com">By Monocursive ↗</a></div>
      </div>
    </footer>
  </body>
</html>
