---
interface Props { id: string; label?: string; compact?: boolean; }
const { id, label = 'Terminal', compact = false } = Astro.props;
const command = "curl --proto '=https' --tlsv1.2 -fsSL https://ukai.sh/install.sh | bash";
---
<div class:list={['terminal', 'install-terminal', { compact }]} data-install>
  <div class="terminal-heading">
    <p class="eyebrow" id={`${id}-heading`}>{label}</p>
    <button class="install-copy" type="button" aria-label="Copy install command" hidden>Copy</button>
  </div>
  <pre tabindex="0" aria-labelledby={`${id}-heading`}><code data-install-command>{command}</code></pre>
  <p class="install-copy-status visually-hidden" role="status"></p>
</div>

<script>
  for (const terminal of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const button = terminal.querySelector<HTMLButtonElement>('.install-copy');
    const command = terminal.querySelector<HTMLElement>('[data-install-command]');
    const status = terminal.querySelector<HTMLElement>('.install-copy-status');
    if (!button || !command || !status || !navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        button.textContent = 'Copied';
        status.textContent = 'Install command copied.';
        status.classList.add('visually-hidden');
      } catch {
        status.textContent = 'Could not copy. Select the command to copy it manually.';
        status.classList.remove('visually-hidden');
      }
    });
  }
</script>
