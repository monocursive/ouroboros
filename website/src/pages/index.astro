---
import Site from '../layouts/Site.astro';
import ActionLink from '../components/ActionLink.astro';
import BoundaryStep from '../components/BoundaryStep.astro';
import InstallCommand from '../components/InstallCommand.astro';
import { jailCommand, releasedDocument, repositoryUrl, vmCommand } from '../release';

const protections = [
  { title: 'Your home directory', text: 'SSH keys, cloud credentials and your other projects do not exist inside the sandbox unless you grant them. The agent sees the system’s programs, its workspace and a scratch directory.' },
  { title: 'Your network', text: 'No network by default. Agent profiles reach only the hosts you name, such as your model provider and package registry, through Ukai’s proxy.' },
  { title: 'Your time', text: 'A hard deadline for the whole process tree. When the run ends, Ukai confirms every process is gone before it writes the final receipt.' },
];
const questions = [
  { title: 'What was allowed?', field: 'applied', text: 'The boundary actually in force. Here: no network and a 30-second deadline.' },
  { title: 'How did it end?', field: 'outcome', text: 'The exit status, and in lifetime, confirmation that no process outlived the run.' },
  { title: 'What couldn’t Ukai see?', field: 'coverage', text: 'What was observed, class by class, and every gap. A gap is reported, never hidden.' },
];
const reasons = [
  { title: 'One tool for every agent.', text: 'The same flags work for Claude Code, Codex, OpenCode or npm test.' },
  { title: 'Enforced outside the agent.', text: 'You set the limits at launch and the Linux kernel enforces them, so the agent can’t loosen its own rules.' },
  { title: 'Nothing to build.', text: 'No container image, no daemon and no sudo to run. One binary wraps the command you already use.' },
  { title: 'A record you can check.', text: 'Every run leaves a receipt, on your laptop, your servers or in CI.' },
];
const steps = [
  { number: '01', title: 'Set limits.', text: 'Start from a profile, then grant the paths, hosts and time the task needs.' },
  { number: '02', title: 'Run your command.', text: 'Run your agent or CLI tool as usual. Ukai applies the limits to it and its child processes.' },
  { number: '03', title: 'Review the run.', text: 'Read the receipt for the policy applied, the result and any gaps in observation. Then review the file changes.' },
];
const limits = [
  'An agent can still change the files you make writable and send readable data to the hosts you allow. Keep grants small and review the changes.',
  'Observation covers a defined set of operations, not every read. The receipt says which ones it covered.',
  'Containment relies on the host kernel. Ukai is a developer preview, and its security review is still pending.',
  'The Mac preview runs offline Linux commands in a VM. It does not run native Mac programs or online agents.',
];
// A real run on the Linux reference host (x86_64, Ubuntu 26.04), 15 October 2026,
// recorded in docs/benchmarks/jail/website-sample-run-2026-10-15.md. The output
// lines are verbatim; the receipt is an excerpt of that run's jail.json.
const run = `$ ukai-jail run --profile tool --workspace . --limit wall=30s -- \\
    sh -c "cat $HOME/.ssh/authorized_keys; curl -sS https://example.com; echo ok > result.txt"
cat: /home/ubuntu/.ssh/authorized_keys: No such file or directory
curl: (6) Could not resolve host: example.com
$ cat result.txt
ok`;
const receipt = `{
  "schema": "ukai.jail.receipt/1",
  "phase": "settled",
  "containment": "enforced",
  "outcome": { "kind": "exited", "code": 0, … },
  "applied": {
    "network": { "mode": "none", "mechanism": "network-namespace", … },
    "limits": [
      { "key": "wall", "requested": "30000", "applied": true, "hit": false, … },
      …
    ],
    …
  },
  "lifetime": { "tree_empty": true, "integrity": "verified", … },
  "coverage": {
    "exec": { "status": "active", "observed_count": 7, "gaps": [], … },
    "fs.write": { "status": "active", "observed_count": 1, "gaps": [], … },
    "net": { "status": "active", "observed_count": 2, "gaps": [], … },
    …
  },
  "errors": []
}`;
const compatibility = `${releasedDocument('docs/specs/jail-v1/agent-compatibility.md')}`;
const benchmark = `${releasedDocument('docs/benchmarks/jail/followup-2026-09-29.md')}#k17-results`;
const runRecord = `${repositoryUrl}/blob/dev/docs/benchmarks/jail/website-sample-run-2026-10-15.md`;
const renamedPreview = jailCommand !== 'ukai-jail';
---
<Site title="Ukai — Sandbox for coding agents on Linux" description="Ukai sandboxes Claude Code, Codex, OpenCode and any CLI on Linux: limit files, network and runtime, and get a receipt of every run.">
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">Open-source sandbox for coding agents</p>
      <h1 id="hero-heading">Give your agent a repo, not your machine.</h1>
      <p class="introduction">Ukai wraps Claude Code, Codex, OpenCode or any command-line tool on Linux. You choose which files it can touch, which hosts it can reach and how long it can run. Every run ends with a receipt: what was allowed, what happened, and what Ukai couldn’t see.</p>
      <InstallCommand id="hero-install" label="Install" compact />
      <p class="preview-label">Linux x86_64 and ARM64 · Mac: offline VM preview · MIT · Developer preview</p>
      <div class="hero-actions">
        <ActionLink href="/guide/" primary>Read the quickstart</ActionLink>
        <ActionLink href="#run" direction="down">See a real run</ActionLink>
      </div>
    </div>
    <img class="hero-mark" src="/brand/ukai.svg" width="400" height="400" alt="" fetchpriority="high" />
  </section>

  <section class="boundary-section" id="security" aria-labelledby="protect-heading">
    <div class="container section-stack">
      <div class="section-intro">
        <p class="eyebrow">What stays protected</p>
        <h2 id="protect-heading">Your machine stays yours.</h2>
        <p>Coding agents run with your user account. Ukai gives them a workspace and nothing else you didn’t choose.</p>
      </div>
      <div class="boundary-steps">
        {protections.map((item) => (
          <article class="boundary-step">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="run-section container" id="run" aria-labelledby="run-heading">
    <div class="section-intro">
      <p class="eyebrow">A real run</p>
      <h2 id="run-heading">One command. One receipt.</h2>
      <p>We ran this on our Linux reference host. The command tries to read an SSH file, reach the internet and write a file in its workspace. Only the write goes through.</p>
    </div>
    <div class="terminal">
      <div class="terminal-heading"><p class="eyebrow" id="run-terminal-heading">Terminal</p></div>
      <pre tabindex="0" aria-labelledby="run-terminal-heading"><code>{run}</code></pre>
    </div>
    <div class="receipt-grid">
      <div class="terminal receipt">
        <div class="terminal-heading"><p class="eyebrow" id="receipt-heading">jail.json · excerpt</p></div>
        <pre tabindex="0" aria-labelledby="receipt-heading"><code>{receipt}</code></pre>
      </div>
      <div class="questions">
        <p class="questions-heading">The receipt answers three questions.</p>
        {questions.map((item) => (
          <article class="question">
            <h3>{item.title}</h3>
            <p><code>{item.field}</code> · {item.text}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="run-record">
      <p class="install-note">Fields trimmed for length (…). Each run also keeps an event journal; read it with <code>ukai-jail tail</code>. The run record holds this run’s full output, receipt, policy and journal, with the build and host it ran on.</p>
      <ActionLink href={runRecord}>Full record of this run</ActionLink>
    </div>
  </section>

  <section class="boundary-section" id="agents" aria-labelledby="agents-heading">
    <div class="container agents-grid">
      <div class="section-intro">
        <p class="eyebrow">Works with</p>
        <h2 id="agents-heading">The agent you already use.</h2>
        <p>Launch profiles for 14 agents, including Claude Code, Codex, OpenCode and Gemini CLI, plus any command-line tool. All profiles are experimental; OpenCode has recorded live runs.</p>
        <ActionLink href={compatibility}>Compatibility records</ActionLink>
      </div>
      <div class="reasons">
        <h3>Why not Docker, or your agent’s own sandbox?</h3>
        <ul>
          {reasons.map((item) => <li><strong>{item.title}</strong> {item.text}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="install-section container" aria-labelledby="steps-heading">
    <div class="section-intro">
      <p class="eyebrow">How it works</p>
      <h2 id="steps-heading">Set limits. Run. Review.</h2>
    </div>
    <div class="boundary-steps" id="use-cases">{steps.map((step) => <BoundaryStep {...step} />)}</div>
  </section>

  <section class="boundary-section" id="get-started" aria-labelledby="install-heading">
    <div class="container install-content">
      <div class="section-intro">
        <p class="eyebrow">Developer preview</p>
        <h2 id="install-heading">Install Ukai</h2>
        <p>Install the developer preview, then follow the quickstart for your platform.</p>
      </div>
      <InstallCommand id="install" />
      <p class="install-note">The installer detects your platform and verifies SHA-256 hashes. No compiler or sudo required.</p>
      <div class="platforms">
        <article class="platform">
          <p class="eyebrow">Linux</p>
          <h3>Run agents and CLI tools.</h3>
          <p>Signed x86_64 and ARM64 packages. Requires glibc 2.39+ and bubblewrap.</p>
          <ActionLink href="/guide/#install-the-developer-preview">Linux quickstart</ActionLink>
        </article>
        <article class="platform">
          <p class="eyebrow">macOS VM preview</p>
          <h3>Run offline Linux commands.</h3>
          <p>Runs in a disposable VM. Requires Apple Silicon, macOS 27+, and 8 GiB free APFS storage.</p>
          <ActionLink href="/guide/#macos-vm-preview">Mac quickstart &amp; limits</ActionLink>
        </article>
      </div>
      {renamedPreview && (
        <p class="preview-note">Ukai was called Ouroboros until October 2026. The current preview still installs the <code>{jailCommand}</code> and <code>{vmCommand}</code> commands; the next release installs <code>ukai-jail</code>.</p>
      )}
    </div>
  </section>

  <section class="install-section container" id="limits" aria-labelledby="limits-heading">
    <div class="section-intro">
      <p class="eyebrow">Limits</p>
      <h2 id="limits-heading">What Ukai doesn’t do</h2>
    </div>
    <ul class="limits-list">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
    <ActionLink href="/guide/#understand-the-boundary">Security limits in the guide</ActionLink>
  </section>

  <section class="evidence-section" id="performance" aria-labelledby="evidence-heading">
    <div class="container evidence-content">
      <h2 id="evidence-heading">Read the guide and the evidence</h2>
      <p>Follow the setup guide, check benchmark results and their limitations, or see what we’re building next.</p>
      <div class="evidence-links">
        <ActionLink href="/guide/">Read the guide</ActionLink>
        <ActionLink href={benchmark}>Benchmarks &amp; limitations</ActionLink>
        <ActionLink href="/roadmap/">View the roadmap</ActionLink>
      </div>
    </div>
  </section>
</Site>
