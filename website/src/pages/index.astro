---
import '@fontsource-variable/manrope';
import '../styles/global.css';

const repository = 'https://github.com/monocursive/ouroboros';
const docs = `${repository}/blob/main/docs`;
const installCommand = 'curl -fsSL https://github.com/monocursive/ouroboros/releases/latest/download/install.sh | bash';
const description = 'An experimental, distributed runtime for AI coding agents. Recover durable sessions, verify recorded runs, and place work across your own machines.';
const capabilities = [
  { number: '01', title: 'Recover. Replay. Verify.', description: 'Durable sessions preserve the work. Verified replay checks recorded turns through the agent loop, without new model calls or tool execution.', href: `${docs}/REPLAY.md` },
  { number: '02', title: 'Put your fleet to work.', description: 'Place subagents by machine or toolchain tag. Native BEAM clustering tracks session ownership and each child’s Git worktree lease.', href: `${docs}/FLEET.md` },
  { number: '03', title: 'Give capabilities clear limits.', description: 'Extend through signed WebAssembly components with explicit host imports. Unknown imports are refused before a component can run.', href: `${docs}/ARCHITECTURE.md` },
  { number: '04', title: 'Let it evolve. Keep your say.', description: 'Agents can forge new runtime capabilities. Replay evidence gates policy promotion; signing and deployment stay under your control.', href: `${docs}/SELF.md` },
];
const modelProviders = [
  { provider: 'OpenAI', models: 'GPT & Codex', access: 'ChatGPT sign-in or API key', description: 'Use your plan’s Codex allowance, or connect your OpenAI API account.' },
  { provider: 'Anthropic', models: 'Claude', access: 'API key', description: 'Connect directly with your Anthropic API account.' },
  { provider: 'xAI', models: 'Grok', access: 'API key', description: 'Connect directly with your xAI API account.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d0c" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content="Ouroboros — Keep the work alive." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>Ouroboros — Keep the work alive.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container navigation">
        <a class="brand" href="#" aria-label="Ouroboros home">
          <img src="/brand/ouroboros.svg" width="36" height="36" alt="" />
          <span>ouroboros</span>
        </a>
        <nav aria-label="Main navigation">
          <a class="runtime-nav" href="#runtime">The runtime</a>
          <a class="models-nav" href="#models">Models &amp; access</a>
          <a href={`${repository}#documentation`}>Documentation</a>
          <a class="github-link" href={repository}>GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <a class="release eyebrow" href={`${repository}/releases/tag/v0.1.2`}>
            <span class="status-dot" aria-hidden="true"></span>
            <span>v0.1.2 is here</span><span class="release-divider" aria-hidden="true">/</span><span>Open source</span>
          </a>
          <h1 id="hero-heading">Keep the<br />work alive.</h1>
          <p class="introduction">An experimental, distributed runtime for AI coding agents.<br class="desktop-break" /> Recover durable sessions, verify recorded runs, and place work<br class="desktop-break" /> across your own machines.</p>
          <a class="text-link explore-link" href="#runtime">Explore the runtime <span aria-hidden="true">↓</span></a>
        </div>
        <div class="emblem" aria-hidden="true">
          <div class="emblem-glow"></div>
          <img class="orbit orbit-outer" src="/brand/orbit-outer.svg" width="440" height="440" alt="" />
          <img class="orbit orbit-middle" src="/brand/orbit-middle.svg" width="346" height="346" alt="" />
          <img class="orbit orbit-inner" src="/brand/orbit-inner.svg" width="242" height="242" alt="" />
          <img class="hero-mark" src="/brand/ouroboros.svg" width="380" height="380" alt="" fetchpriority="high" />
          <div class="orbit-motion"><img src="/brand/orbit-point.svg" width="6" height="6" alt="" /></div>
          <span class="field-label">Continuity / by design</span>
        </div>
      </section>

      <section class="installation container" id="install" aria-labelledby="install-heading">
        <div class="terminal">
          <div class="terminal-heading">
            <h2 id="install-heading" class="eyebrow">Get started</h2>
            <a class="platforms" href={`${docs}/RELEASING.md#platforms-and-prerequisites`}>macOS + GNU/Linux <span aria-hidden="true">·</span> ARM64 + x86_64</a>
          </div>
          <div class="command-row">
            <pre tabindex="0" aria-label="Installation command"><code id="install-command">{installCommand}</code></pre>
            <button type="button" id="copy-command" class="copy-button" aria-label="Copy installation command" hidden>
              <span data-copy-label>Copy</span>
            </button>
          </div>
        </div>
        <div class="install-notes">
          <p>Then run <code>ouro</code> in your project. <span>Runtime included. No Elixir or Rust required.</span></p>
          <a href={`${docs}/RELEASING.md`}>Installation guide <span aria-hidden="true">↗︎</span></a>
        </div>
        <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>
      </section>

      <section class="runtime" id="runtime" aria-labelledby="runtime-heading">
        <div class="container">
          <p class="eyebrow section-eyebrow">The runtime / four convictions</p>
          <h2 id="runtime-heading">Your machines.<br />One agent runtime.</h2>
          <div class="capabilities">
            {capabilities.map((item) => (
              <article class="capability">
                <h3><a href={item.href}><span class="capability-number" aria-hidden="true">{item.number} <span>/</span></span>{item.title}<span class="capability-arrow" aria-hidden="true">↗︎</span></a></h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="models" id="models" aria-labelledby="models-heading">
        <div class="container">
          <p class="eyebrow section-eyebrow">Models &amp; access</p>
          <div class="models-heading-row">
            <h2 id="models-heading">Bring your model.</h2>
            <a class="text-link" href={`${repository}#quick-start`}>Model setup <span aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11 11 3M3 3h8v8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
          </div>
          <div class="model-providers">
            {modelProviders.map((item) => (
              <article class="model-provider">
                <p class="eyebrow provider-name">{item.provider}</p>
                <h3>{item.models}</h3>
                <p class="model-access">{item.access}</p>
                <p class="model-description">{item.description}</p>
              </article>
            ))}
          </div>
          <div class="model-configuration">
            <p class="eyebrow">Also configurable</p>
            <p>Gemini API <span aria-hidden="true">/</span> OpenRouter API <span aria-hidden="true">/</span> Local models via Ollama</p>
          </div>
          <p class="model-billing">API usage is billed separately by each provider. Claude and Grok app subscriptions do not provide API access here. <a href="https://help.openai.com/en/articles/11369540-using-codex-with-your-chatgpt-plan">ChatGPT plan access</a>, model availability, and usage limits depend on your account.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-status">
          <p>A working research project. Built in the open, still evolving.</p>
          <a class="text-link" href={`${docs}/ARCHITECTURE.md`}>Architecture &amp; known limits</a>
        </div>
        <div class="footer-credits">
          <a href="https://monocursive.com">© {new Date().getUTCFullYear()} Monocursive</a>
          <p><a href={`${repository}/blob/main/LICENSE`}>MIT license</a><span aria-hidden="true">/</span><span>Made to continue</span></p>
        </div>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#copy-command');
      const command = document.querySelector<HTMLElement>('#install-command');
      const status = document.querySelector<HTMLElement>('#copy-status');
      const label = button?.querySelector<HTMLElement>('[data-copy-label]');
      let resetTimer: ReturnType<typeof setTimeout>;

      if (button && command && status && label) {
        button.hidden = false;
        button.addEventListener('click', async () => {
          clearTimeout(resetTimer);
          try {
            await navigator.clipboard.writeText(command.textContent ?? '');
            label.textContent = 'Copied';
            button.dataset.copied = 'true';
            status.textContent = 'Installation command copied to clipboard.';
          } catch {
            const range = document.createRange();
            range.selectNodeContents(command);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            command.parentElement?.focus();
            label.textContent = 'Selected';
            status.classList.remove('sr-only');
            status.textContent = 'Copy is unavailable. The command is selected; use your browser’s Copy action.';
          }
          resetTimer = setTimeout(() => {
            label.textContent = 'Copy';
            delete button.dataset.copied;
            status.textContent = '';
            status.classList.add('sr-only');
          }, 5000);
        });
      }
    </script>
  </body>
</html>
