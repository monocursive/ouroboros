# Finder metadata is machine-local, never repository input.
.DS_Store

# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Browser-test dependencies and generated Playwright evidence.
/node_modules/
/playwright-report/
/test-results/

# ElixirLS writes language-server indexes and build artifacts here.
/.elixir_ls/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ouroboros-*.tar

# Release tarballs (built via "mix release --tar"), which is how a node's artifact ships.
*.tar.gz
# The integration fixture is a committed record, not a built artifact (scripts/fixture/boot_gate.sh).
!/test/support/integration_fixture/fixture-datadir.tar.gz

# The Rust TUI crate's build directory.
/tui/target/

# The lane-W acceptance guest: its own build directory, and the component `make wasm-guest`
# copies out of it. Source — Cargo.toml, Cargo.lock, src/lib.rs — is kept; the built
# component is not, for the same reason `/priv/wasm/` is not. A `.wasm` in a repository is an
# opaque binary nobody reviews, and this one is reproducible from the world file beside it.
/test/support/wasm/echo-guest/target/
/test/support/wasm/echo.wasm

# The guest SDK and its worked components, each a workspace of its own and therefore each with
# a build directory of its own. Source is kept, including every lockfile — a guest an author
# copies should resolve the same crates tomorrow — and the built `.wasm` is not, for the same
# reason the acceptance guest's is not. `make wasm-examples` rebuilds them; `ouro wasm inspect`
# is how you check one.
/tui/wasm/guest/target/
/tui/wasm/guest/examples/*/target/

# Built helpers; never source artifacts.
/priv/wasm/

# The two JavaScript bundles `mix web.assets` copies out of the dependencies on every
# compile. `app.css` and `app.js` beside them are hand-written source and are kept: the
# rule is that a file which would silently disagree with a dependency after the next
# `mix deps.get` does not live in the repository.
/priv/static/web/phoenix.min.js
/priv/static/web/phoenix_live_view.min.js

# Where `bench/self/run.sh` writes a run: the result object, and one trajectory per task.
# A measurement of one machine at one moment, not repository input.
/bench/self/results/
