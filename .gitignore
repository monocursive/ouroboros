# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# ElixirLS writes language-server indexes and build artifacts here.
/.elixir_ls/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ouroboros-*.tar

# Release tarballs (built via "mix release --tar"), which is how a node's artifact ships.
*.tar.gz

# The Rust TUI crate's build directory.
/tui/target/

# Where `make dist` names a built client for the platform it can run on. The artifact of
# record is the one a tagged build uploads, not a copy somebody made locally. The two
# things under dist/ that are *source* rather than output — the release signing public
# key `ouro update` compiles in, and the Homebrew formula template — are kept.
/dist/*
!/dist/release.pub
!/dist/homebrew/


# Built Computer Use helper; never a source artifact.
/priv/computer-use/
