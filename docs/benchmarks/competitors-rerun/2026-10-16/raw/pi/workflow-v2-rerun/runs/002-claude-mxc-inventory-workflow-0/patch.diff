diff --git a/inventory/report.py b/inventory/report.py
index 080803f..b619dcb 100644
--- a/inventory/report.py
+++ b/inventory/report.py
@@ -1,4 +1,25 @@
+from decimal import Decimal
+
 def item_report(items, min_quantity=0):
     return [{'sku': x.sku, 'category': x.category, 'quantity': x.quantity,
              'unit_price': str(x.unit_price)}
             for x in items if x.quantity >= min_quantity]
+
+def category_summary(items, min_quantity=0):
+    filtered = [x for x in items if x.quantity >= min_quantity]
+    grouped = {}
+    for item in filtered:
+        if item.category not in grouped:
+            grouped[item.category] = {'quantity': 0, 'value': Decimal('0')}
+        grouped[item.category]['quantity'] += item.quantity
+        grouped[item.category]['value'] += item.quantity * item.unit_price
+
+    result = []
+    for category in sorted(grouped.keys()):
+        data = grouped[category]
+        result.append({
+            'category': category,
+            'quantity': data['quantity'],
+            'stock_value': f"{data['value']:.2f}"
+        })
+    return result
