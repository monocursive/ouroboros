+#[cfg(test)]
+mod placement_tests {
+    use super::*;
+    use std::io::Read as _;
+    use std::os::fd::AsFd as _;
+
+    #[test]
+    fn placement_precedes_exec_and_map_collisions_without_leaking_its_descriptor() {
+        let (reader, placement) = pipe().unwrap();
+        let identity =
+            std::fs::read_link(format!("/proc/self/fd/{}", placement.as_raw_fd())).unwrap();
+        let target = placement.as_raw_fd();
+        let (_other_reader, other_writer) = pipe().unwrap();
+        let mut map = FdMap::new();
+        // A map target can occupy the control's original low-numbered slot.
+        // Placement must remain correct, and that target is the only allowed
+        // inherited descriptor besides stdio.
+        map.add(other_writer, target).unwrap();
+        let mut command = Command::new("/bin/sh");
+        command.args([
+            "-c",
+            "for fd in /proc/$$/fd/*; do \
+             if [ \"$(readlink \"$fd\")\" = \"$1\" ]; then exit 42; fi; \
+             done; printf '%s' \"$$\"",
+            "placement-check",
+        ]);
+        command.arg(identity);
+        command.stdout(Stdio::piped()).stderr(Stdio::piped());
+        map.apply_in_cgroup(&mut command, placement).unwrap();
+        let child = command.spawn().unwrap();
+        let expected = child.id().to_string();
+        let output = finish_captured(child, Deadline::after(Duration::from_secs(5))).unwrap();
+        assert_eq!(output.code(), Some(0), "{}", output.stderr);
+        assert_eq!(output.stdout, expected);
+        drop(command);
+        let mut written = String::new();
+        std::fs::File::from(reader)
+            .read_to_string(&mut written)
+            .unwrap();
+        assert_eq!(written, expected, "the fork hook wrote its own child PID");
+    }
+
+    #[test]
+    fn a_failed_placement_refuses_before_the_program_executes() {
+        let (read_only, _writer) = pipe().unwrap();
+        let root = tempfile::tempdir().unwrap();
+        let marker = root.path().join("must-not-execute");
+        let mut command = Command::new("/bin/sh");
+        command.args(["-c", "touch \"$1\"", "placement-check"]);
+        command.arg(&marker);
+        FdMap::new()
+            .apply_in_cgroup(
+                &mut command,
+                read_only.as_fd().try_clone_to_owned().unwrap(),
+            )
+            .unwrap();
+        assert_eq!(
+            command.spawn().unwrap_err().raw_os_error(),
+            Some(libc::EBADF)
+        );
+        assert!(!marker.exists());
+    }
+}
