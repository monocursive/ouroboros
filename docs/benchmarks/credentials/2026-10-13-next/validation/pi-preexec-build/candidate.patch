+/// One complete decimal PID write, without allocation after fork. Short writes
+/// refuse; writing a suffix as a second PID would not be a safe continuation.
+fn place_self_before_exec(fd: RawFd) -> io::Result<()> {
+    // SAFETY: getpid takes no arguments and cannot fail.
+    let mut pid = unsafe { libc::getpid() }.unsigned_abs();
+    let mut bytes = [0u8; 10];
+    let mut start = bytes.len();
+    while pid != 0 {
+        start -= 1;
+        bytes[start] = b'0' + u8::try_from(pid % 10).unwrap_or(0);
+        pid /= 10;
+    }
+    let value = &bytes[start..];
+    loop {
+        // SAFETY: the pinned descriptor and the stack buffer are live. write
+        // is async-signal-safe. Retrying the same own PID on EINTR is idempotent.
+        let written = unsafe { libc::write(fd, value.as_ptr().cast(), value.len()) };
+        if usize::try_from(written).ok() == Some(value.len()) {
+            return Ok(());
+        }
+        if written >= 0 {
+            return Err(io::Error::from_raw_os_error(libc::EIO));
+        }
+        let error = io::Error::last_os_error();
+        if error.raw_os_error() != Some(libc::EINTR) {
+            return Err(error);
+        }
+    }
