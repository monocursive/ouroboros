f main(argv=None):\n     parser = argparse.ArgumentParser(description='Report inventory from CSV')\n     parser.add_argument('csv_file')\n     parser.add_argument('--min-quantity', type=int, default=0)\n+    parser.add_argument('--group-by-category', action='store_true')\n     args = parser.parse_args(argv)\n     try:\n         items = load_items(args.csv_file)\n-        result = item_report(items, args.min_quantity)\n+        if args.group_by_category:\n+            result = category_report(items, args.min_quantity)\n+        else:\n+            result = item_report(items, args.min_quantity)\n     except (ValueError, OSError) as exc:\n         print(str(exc), file=sys.stderr)\n         return 2\ndiff --git a/inventory/report.py b/inventory/report.py\nindex 080803f..15c399e 100644\n--- a/inventory/report.py\n+++ b/inventory/report.py\n@@ -1,4 +1,24 @@\n+from decimal import Decimal\n+\n def item_report(items, min_quantity=0):\n     return [{'sku': x.sku, 'category': x.category, 'quantity': x.quantity,\n              'unit_price': str(x.unit_price)}\n             for x in items if x.quantity >= min_quantity]\n+\n+def category_report(items, min_quantity=0):\n+    filtered = [x for x in items if x.quantity >= min_quantity]\n+    grouped = {}\n+    for item in filtered:\n+        if item.category not in grouped:\n+            grouped[item.category] = {'quantity': 0, 'stock_value': Decimal('0')}\n+        grouped[item.category]['quantity'] += item.quantity\n+        grouped[item.category]['stock_value'] += item.quantity * item.unit_price\n+\n+    result = []\n+    for category in sorted(grouped.keys()):\n+        result.append({\n+            'category': category,\n+            'quantity': grouped[category]['quantity'],\n+            'stock_value': f\"{grouped[category]['stock_value']:.2f}\"\n+        })\n+    return result\n", "files": {"README.md": "# Inventory CLI\n\nRun `python3 -m inventory.cli examples/stock.csv`.\nUse `--min-quantity 3` to filter before reporting.\nPrices are decimal strings. No third-party dependencies are required.\n\n## Grouped by Category\n\n```\npython3 -m inventory.cli examples/stock.csv --group-by-category\n```\n\nExpected output:\n```json\n[\n  {\"category\": \"kitchen\", \"quantity\": 3, \"stock_value\": \"12.75\"},\n  {\"category\": \"office\", \"quantity\": 12, \"stock_value\": \"6.00\"}\n]\n```\n", "pyproject.toml": "[project]\nname = \"inventory-cli\"\nversion = \"0.1.0\"\nrequires-python = \">=3.10\"\n", "tests/__init__.py": "", "tests/test_loader.py": "import unittest\nimport tempfile\nfrom pathlib import Path\nfrom decimal import Decimal\nfrom inventory.loader import load_items\n\nclass LoaderTests(unittest.TestCase):\n    def load(self, text):\n        with tempfile.TemporaryDirectory() as d:\n            p = Path(d) / 'stock.csv'\n            p.write_text(text)\n            return load_items(p)\n    def test_exact_prices(self):\n        x = self.load('sku,category,quantity,unit_price\\na,tools,3,0.10\\n')[0]\n        self.assertEqual(x.unit_price, Decimal('0.10'))\n    def test_missing_header(self):\n        with self.assertRaises(ValueError): self.load('name\\na\\n')\n    def test_invalid_quantity(self):\n        with self.assertRaises(ValueError):\n            self.load('sku,category,quantity,unit_price\\na,tools,no,1\\n')\n    def test_negative_quantity(self):\n        with self.assertRaises(ValueError):\n            self.load('sku,category,quantity,unit_price\\na,tools,-1,1\\n')\n    def test_nonfinite_price(self):\n        with self.assertRaises(ValueError):\n            self.load('sku,category,quantity,unit_price\\na,tools,1,NaN\\n')\n", "tests/test_cli.py": "import json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nDATA = 'sku,category,quantity,unit_price\\npen,office,10,0.10\\nnotebook,office,2,2.50\\nmug,kitchen,3,4.25\\n'\n\nclass CliTests(unittest.TestCase):\n    def cli(self, data=DATA, *flags):\n        with tempfile.TemporaryDirectory() as d:\n            p = Path(d) / 'stock.csv'\n            p.write_text(data)\n            return subprocess.run([sys.executable, '-m', 'inventory.cli', str(p), *flags], capture_output=True, text=True)\n    def test_ungrouped(self):\n        r = self.cli()\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual(len(json.loads(r.stdout)), 3)\n        self.assertEqual(json.loads(r.stdout)[0]['unit_price'], '0.10')\n    def test_filter(self):\n        r = self.cli(DATA, '--min-quantity', '3')\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual([x['sku'] for x in json.loads(r.stdout)], ['pen', 'mug'])\n    def test_category_summaries(self):\n        r = self.cli(DATA, '--group-by-category')\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual(json.loads(r.stdout), [\n            {'category': 'kitchen', 'quantity': 3, 'stock_value': '12.75'},\n            {'category': 'office', 'quantity': 12, 'stock_value': '6.00'}])\n    def test_filter_before_group(self):\n        r = self.cli(DATA, '--group-by-category', '--min-quantity', '3')\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual(json.loads(r.stdout)[1]['stock_value'], '1.00')\n    def test_bad_csv(self):\n        r = self.cli('sku,category,quantity,unit_price\\na,b,invalid,2\\n')\n        self.assertEqual(r.returncode, 2)\n        self.assertNotIn('Traceback', r.stderr)\n        self.assertIn('row', r.stderr.lower())\n", "inventory/__init__.py": "\"\"\"Inventory reporting tools.\"\"\"\n", "inventory/report.py": "from decimal import Decimal\n\ndef item_report(items, min_quantity=0):\n    return [{'sku': x.sku, 'category': x.category, 'quantity': x.quantity,\n             'unit_price': str(x.unit_price)}\n            for x in items if x.quantity >= min_quantity]\n\ndef category_report(items, min_quantity=0):\n    filtered = [x for x in items if x.quantity >= min_quantity]\n    grouped = {}\n    for item in filtered:\n        if item.category not in grouped:\n            grouped[item.category] = {'quantity': 0, 'stock_value': Decimal('0')}\n        grouped[item.category]['quantity'] += item.quantity\n        grouped[item.category]['stock_value'] += item.quantity * item.unit_price\n\n    result = []\n    for category in sorted(grouped.keys()):\n        result.append({\n            'category': category,\n            'quantity': grouped[category]['quantity'],\n            'stock_value': f\"{grouped[category]['stock_value']:.2f}\"\n        })\n    return result\n", "inventory/cli.py": "import argparse\nimport json\nimport sys\nfrom .loader import load_items\nfrom .report import item_report, category_report\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description='Report inventory from CSV')\n    parser.add_argument('csv_file')\n    parser.add_argument('--min-quantity', type=int, default=0)\n    parser.add_argument('--group-by-category', action='store_true')\n    args = parser.parse_args(argv)\n    try:\n        items = load_items(args.csv_file)\n        if args.group_by_category:\n            result = category_report(items, args.min_quantity)\n        else:\n            result = item_report(items, args.min_quantity)\n    except (ValueError, OSError) as exc:\n        print(str(exc), file=sys.stderr)\n        return 2\n    print(json.dumps(result, ensure_ascii=False))\n    return 0\n\nif __name__ == '__main__':\n    sys.exit(main())\n", "inventory/models.py": "from dataclasses import dataclass\nfrom decimal import Decimal\n\n@dataclass(frozen=True)\nclass Item:\n    sku: str\n    category: str\n    quantity: int\n    unit_price: Decimal\n", "inventory/loader.py": "import csv\nfrom decimal import Decimal, InvalidOperation\nfrom .models import Item\n\ndef load_items(path):\n    items = []\n    with open(path, newline='', encoding='utf-8') as source:\n        reader = csv.DictReader(source)\n        required = {'sku', 'category', 'quantity', 'unit_price'}\n        if not required.issubset(reader.fieldnames or []):\n            raise ValueError('CSV requires sku, category, quantity and unit_price')\n        for line, row in enumerate(reader, 2):\n            try:\n                quantity = int(row['quantity'])\n                price = Decimal(row['unit_price'])\n                if quantity < 0 or price < 0 or not price.is_finite():\n                    raise ValueError('negative or non-finite value')\n                items.append(Item(row['sku'], row['category'], quantity, price))\n            except (ValueError, InvalidOperation, TypeError) as exc:\n                raise ValueError(f'Invalid CSV row {line}: {exc}') from exc\n    return items\n", "examples/stock.csv": "sku,category,quantity,unit_price\npen,office,10,0.10\nnotebook,office,2,2.50\nmug,kitchen,3,4.25\n"}, "usage": {"total_cost_usd": 0.19757865000000002, "num_turns": 22, "duration_api_ms": 63222}, "peak_child_rss_kib": 271000, "guest_kernel": ["Linux", "7f0ddd07f557", "7.0.0-31-generic", "#31-Ubuntu SMP PREEMPT_DYNAMIC Sat Aug  1 04:26:38 UTC 2026", "x86_64"], "resource_limits": {"memory.max": "max", "memory.swap.max": "max", "pids.max": "3548", "cpu.max": "max 100000"}}
