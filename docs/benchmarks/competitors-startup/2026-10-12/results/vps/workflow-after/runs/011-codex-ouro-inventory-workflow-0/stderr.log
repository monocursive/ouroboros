index 080803fe51f31cdb386b5cc698650f560d60dd0e..5527f23b2f93d573bba88064e5eb0ddd68152992
--- a/inventory/report.py
+++ b/inventory/report.py
@@ -1,4 +1,33 @@
+from decimal import Decimal, localcontext
+
+
 def item_report(items, min_quantity=0):
     return [{'sku': x.sku, 'category': x.category, 'quantity': x.quantity,
              'unit_price': str(x.unit_price)}
             for x in items if x.quantity >= min_quantity]
+
+
+def category_report(items, min_quantity=0):
+    items = [item for item in items if item.quantity >= min_quantity]
+    if not items:
+        return []
+
+    # Reserve enough precision for exact products and sums across price scales.
+    fractional_digits = max(0, max(-item.unit_price.as_tuple().exponent
+                                   for item in items))
+    integer_digits = max(0, max(item.unit_price.adjusted() + 1
+                               for item in items))
+    quantity_digits = max(len(str(item.quantity)) for item in items)
+    with localcontext() as context:
+        context.prec = (integer_digits + fractional_digits + quantity_digits
+                        + len(str(len(items))) + 2)
+        groups = {}
+        for item in items:
+            quantity, value = groups.get(item.category, (0, Decimal('0')))
+            groups[item.category] = (quantity + item.quantity,
+                                     value + item.quantity * item.unit_price)
+        return [
+            {'category': category, 'quantity': quantity,
+             'stock_value': format(value, '.2f')}
+            for category, (quantity, value) in sorted(groups.items())
+        ]

