'], quantity, price))\n            except (ValueError, InvalidOperation, TypeError) as exc:\n                raise ValueError(f'Invalid CSV row {line}: {exc}') from exc\n    return items\n", "inventory/report.py": "from decimal import Decimal\n\ndef item_report(items, min_quantity=0):\n    return [{'sku': x.sku, 'category': x.category, 'quantity': x.quantity,\n             'unit_price': str(x.unit_price)}\n            for x in items if x.quantity >= min_quantity]\n\ndef category_summary_report(items, min_quantity=0):\n    \"\"\"Group items by category and return summary with total quantity and stock value.\"\"\"\n    # Filter items by min_quantity first\n    filtered = [item for item in items if item.quantity >= min_quantity]\n    \n    # Group by category\n    categories = {}\n    for item in filtered:\n        if item.category not in categories:\n            categories[item.category] = {'quantity': 0, 'stock_value': Decimal('0')}\n        categories[item.category]['quantity'] += item.quantity\n        categories[item.category]['stock_value'] += item.quantity * item.unit_price\n    \n    # Build result sorted by category\n    result = []\n    for category in sorted(categories.keys()):\n        result.append({\n            'category': category,\n            'quantity': categories[category]['quantity'],\n            'stock_value': f\"{categories[category]['stock_value']:.2f}\"\n        })\n    \n    return result\n", "inventory/cli.py": "import argparse\nimport json\nimport sys\nfrom .loader import load_items\nfrom .report import item_report, category_summary_report\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description='Report inventory from CSV')\n    parser.add_argument('csv_file')\n    parser.add_argument('--min-quantity', type=int, default=0)\n    parser.add_argument('--group-by-category', action='store_true')\n    args = parser.parse_args(argv)\n    try:\n        items = load_items(args.csv_file)\n        if args.group_by_category:\n         