ython3 -m inventory.cli examples/stock.csv`.\nUse `--min-quantity 3` to filter before reporting.\nPrices are decimal strings. No third-party dependencies are required.\n\nSummarize by category, filtering individual items before grouping:\n\n```sh\npython3 -m inventory.cli examples/stock.csv --group-by-category --min-quantity 3\n```\n\nExpected output (sorted by category):\n\n```json\n[{\"category\": \"kitchen\", \"quantity\": 3, \"stock_value\": \"12.75\"}, {\"category\": \"office\", \"quantity\": 10, \"stock_value\": \"1.00\"}]\n```\n\nEach summary includes the total quantity and the sum of quantity times unit\nprice. Stock values use exact decimal arithmetic and are formatted as strings\nwith two fractional digits.\n", "inventory/__init__.py": "\"\"\"Inventory reporting tools.\"\"\"\n", "inventory/models.py": "from dataclasses import dataclass\nfrom decimal import Decimal\n\n@dataclass(frozen=True)\nclass Item:\n    sku: str\n    category: str\n    quantity: int\n    unit_price: Decimal\n", "inventory/loader.py": "import csv\nfrom decimal import Decimal, InvalidOperation\nfrom .models import Item\n\ndef load_items(path):\n    items = []\n    with open(path, newline='', encoding='utf-8') as source:\n        reader = csv.DictReader(source, strict=True)\n        required = {'sku', 'category', 'quantity', 'unit_price'}\n        if not required.issubset(reader.fieldnames or []):\n            raise ValueError('CSV requires sku, category, quantity and unit_price')\n        for line, row in enumerate(reader, 2):\n            try:\n                if None in row or any(row[field] is None for field in required):\n                    raise ValueError('missing or extra CSV fields')\n                quantity = int(row['quantity'])\n                price = Decimal(row['unit_price'])\n                if quantity < 0 or price < 0 or not price.is_finite():\n                    raise ValueError('negative or non-finite value')\n                items.append(Item(row['sku'], row['category'], quantity, price))\n            except (ValueError, InvalidOperation, TypeError) as exc:\n                raise ValueError(f'Invalid CSV row {line}: {exc}') from exc\n    return items\n", "inventory/report.py": "from decimal import Decimal, localcontext\n\n\ndef item_report(items, min_quantity=0):\n    return [{'sku': x.sku, 'category': x.category, 'quantity': x.quantity,\n             'unit_price': str(x.unit_price)}\n            for x in items if x.quantity >= min_quantity]\n\n\ndef category_report(items, min_quantity=0):\n    items = [item for item in items if item.quantity >= min_quantity]\n    if not items:\n        return []\n\n    # Reserve enough digits for exact multiplication and addition, including\n    # prices with widely different scales and a carry from summing all rows.\n    fractional_digits = max(max(0, -item.unit_price.as_tuple().exponent)\n                            for item in items)\n    integer_digits = max(len(item.unit_price.as_tuple().digits)\n                         + max(0, item.unit_price.as_tuple().exponent)\n                         + len(str(item.quantity)) for item in items)\n    with localcontext() as context:\n        context.prec = max(28, integer_digits + fractional_digits\n                           + len(str(len(items))))\n        summaries = {}\n        for item in items:\n            summary = summaries.setdefault(item.category, [0, Decimal(0)])\n            summary[0] += item.quantity\n            summary[1] += item.quantity * item.unit_price\n        return [{'category': category, 'quantity': quantity,\n                 'stock_value': format(stock_value, '.2f')}\n                for category, (quantity, stock_value)\n                in sorted(summaries.items())]\n", "inventory/cli.py": "import argparse\nimport csv\nimport json\nimport sys\nfrom .loader import load_items\nfrom .report import category_report, item_report\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description='Report inventory from CSV')\n    parser.add_argument('csv_file')\n    parser.add_argument('--min-quantity', type=int, default=0)\n    parser.add_argument('--group-by-category', action='store_true',\n                        help='Summarize quantity and stock value by category')\n    args = parser.parse_args(argv)\n    try:\n        items = load_items(args.csv_file)\n        report = category_report if args.group_by_category else item_report\n        result = report(items, args.min_quantity)\n    except (ValueError, OSError, csv.Error) as exc:\n        print(str(exc), file=sys.stderr)\n        return 2\n    print(json.dumps(result, ensure_ascii=False))\n    return 0\n\nif __name__ == '__main__':\n    sys.exit(main())\n", "examples/stock.csv": "sku,category,quantity,unit_price\npen,office,10,0.10\nnotebook,office,2,2.50\nmug,kitchen,3,4.25\n", "tests/test_loader.py": "import unittest\nimport tempfile\nfrom pathlib import Path\nfrom decimal import Decimal\nfrom inventory.loader import load_items\n\nclass LoaderTests(unittest.TestCase):\n    def load(self, text):\n        with tempfile.TemporaryDirectory() as d:\n            p = Path(d) / 'stock.csv'\n            p.write_text(text)\n            return load_items(p)\n    def test_exact_prices(self):\n        x = self.load('sku,category,quantity,unit_price\\na,tools,3,0.10\\n')[0]\n        self.assertEqual(x.unit_price, Decimal('0.10'))\n    def test_missing_header(self):\n        with self.assertRaises(ValueError): self.load('name\\na\\n')\n    def test_invalid_quantity(self):\n        with self.assertRaises(ValueError):\n            self.load('sku,category,quantity,unit_price\\na,tools,no,1\\n')\n    def test_negative_quantity(self):\n        with self.assertRaises(ValueError):\n            self.load('sku,category,quantity,unit_price\\na,tools,-1,1\\n')\n    def test_nonfinite_price(self):\n        with self.assertRaises(ValueError):\n            self.load('sku,category,quantity,unit_price\\na,tools,1,NaN\\n')\n", "tests/test_cli.py": "import json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nDATA = 'sku,category,quantity,unit_price\\npen,office,10,0.10\\nnotebook,office,2,2.50\\nmug,kitchen,3,4.25\\n'\n\nclass CliTests(unittest.TestCase):\n    def cli(self, data=DATA, *flags):\n        with tempfile.TemporaryDirectory() as d:\n            p = Path(d) / 'stock.csv'\n            p.write_text(data)\n            return subprocess.run([sys.executable, '-m', 'inventory.cli', str(p), *flags], capture_output=True, text=True)\n    def test_ungrouped(self):\n        r = self.cli()\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual(len(json.loads(r.stdout)), 3)\n        self.assertEqual(json.loads(r.stdout)[0]['unit_price'], '0.10')\n    def test_filter(self):\n        r = self.cli(DATA, '--min-quantity', '3')\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual([x['sku'] for x in json.loads(r.stdout)], ['pen', 'mug'])\n    def test_category_summaries(self):\n        r = self.cli(DATA, '--group-by-category')\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual(json.loads(r.stdout), [\n            {'category': 'kitchen', 'quantity': 3, 'stock_value': '12.75'},\n            {'category': 'office', 'quantity': 12, 'stock_value': '6.00'}])\n    def test_filter_before_group(self):\n        r = self.cli(DATA, '--group-by-category', '--min-quantity', '3')\n        self.assertEqual(r.returncode, 0, r.stderr)\n        self.assertEqual(json.loads(r.stdout)[1]['stock_value'], '1.00')\n    def test_bad_csv(self):\n        r = self.cli('sku,category,quantity,unit_price\\na,b,invalid,2\\n')\n        self.assertEqual(r.returncode, 2)\n        self.assertNotIn('Traceback', r.stderr)\n        self.assertIn('row', r.stderr.lower())\n", "tests/__init__.py": ""}, "usage": {}, "peak_child_rss_kib": 315824, "guest_kernel": ["Linux", "9f615ca3b482", "6.15.11-orbstack-00539-g9885ebd8e3f4", "#1 SMP PREEMPT Fri Au