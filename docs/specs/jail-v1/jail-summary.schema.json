{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ukai:schema:jail-summary:1",
  "title": "Jail end-of-run summary",
  "description": "jail-launch-and-summary.md §4.5 (J13): `ukai-jail tail --summary --json`. One rendering of the summary that `run` prints on a terminal, computed by one pure function from the attempt's final receipt and journal alone. Each line's text is the terminal line without its `ukai-jail: ` prefix, escaped as the terminal line is; facts carry the numbers behind it. A count is a number only when its bound is exact or at_least, and null otherwise, never 0 (not_observed: the class was not observed; unavailable: no journal to count from; disagree: the complete journal and the receipt disagree on the class's count; not_recorded: a journal from a build that did not record credential uses). Only a complete journal yields an exact bound. The terminal's receipt line is replaced by attempt_id and receipt_digest. Lines appear in the order status, workspace, network, credentials, evidence, limits, cleanup (validate_contract.py checks the order).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ukai.jail.summary/1"
    },
    "attempt_id": {
      "type": "string"
    },
    "receipt_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "journal": {
      "enum": [
        "complete",
        "incomplete",
        "not_scanned",
        "absent",
        "unreadable"
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 4,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/line"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "line": {
                "const": "status"
              }
            },
            "required": [
              "line"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "line": {
                "const": "workspace"
              }
            },
            "required": [
              "line"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "line": {
                "const": "network"
              }
            },
            "required": [
              "line"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "line": {
                "const": "evidence"
              }
            },
            "required": [
              "line"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "line": {
                "const": "credentials"
              }
            },
            "required": [
              "line"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "properties": {
              "line": {
                "const": "limits"
              }
            },
            "required": [
              "line"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        },
        {
          "contains": {
            "properties": {
              "line": {
                "const": "cleanup"
              }
            },
            "required": [
              "line"
            ]
          },
          "maxContains": 1,
          "minContains": 0
        }
      ]
    }
  },
  "required": [
    "schema",
    "attempt_id",
    "receipt_digest",
    "journal",
    "lines"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Only a complete journal (its last frame the note of this receipt) supports an exact count.",
      "if": {
        "properties": {
          "journal": {
            "not": {
              "const": "complete"
            }
          }
        },
        "required": [
          "journal"
        ]
      },
      "then": {
        "properties": {
          "lines": {
            "items": {
              "properties": {
                "facts": {
                  "properties": {
                    "bound": {
                      "not": {
                        "const": "exact"
                      }
                    },
                    "refused_bound": {
                      "not": {
                        "const": "exact"
                      }
                    },
                    "refusals_bound": {
                      "not": {
                        "const": "exact"
                      }
                    },
                    "credentials": {
                      "items": {
                        "properties": {
                          "uses_bound": {
                            "not": {
                              "const": "exact"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "limit": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "requested": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "requested"
      ],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "line": {
          "enum": [
            "status",
            "workspace",
            "network",
            "credentials",
            "evidence",
            "limits",
            "cleanup"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        },
        "facts": {
          "type": "object"
        }
      },
      "required": [
        "line",
        "text",
        "facts"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "line": {
                "const": "status"
              }
            },
            "required": [
              "line"
            ]
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string"
                  },
                  "code": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "signal": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cause": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exec_to_settled_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attempt_wall_ms": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "survivors": {
                    "enum": [
                      "none_verified",
                      "none_verified_registered_boundary",
                      "not_verified"
                    ]
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true,
                    "maxItems": 128
                  },
                  "integrity": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "phase",
                  "outcome",
                  "code",
                  "signal",
                  "cause",
                  "exec_to_settled_ms",
                  "attempt_wall_ms",
                  "survivors",
                  "errors",
                  "integrity"
                ],
                "additionalProperties": false,
                "not": {
                  "required": [
                    "exec_to_settled_ms",
                    "attempt_wall_ms"
                  ],
                  "properties": {
                    "exec_to_settled_ms": {
                      "type": "integer"
                    },
                    "attempt_wall_ms": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "line": {
                "const": "workspace"
              }
            },
            "required": [
              "line"
            ]
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "bound": {
                    "enum": [
                      "exact",
                      "at_least",
                      "not_observed",
                      "unavailable",
                      "disagree"
                    ]
                  },
                  "opened_for_writing": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "renamed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "removed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unnamed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "refused": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "refused_bound": {
                    "enum": [
                      "exact",
                      "at_least",
                      "not_observed",
                      "unavailable",
                      "disagree"
                    ]
                  },
                  "paths": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "workspace_relative"
                        },
                        "value": {
                          "oneOf": [
                            {
                              "type": "string",
                              "pattern": "^[^\\u0000]*$"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "encoding": {
                                  "const": "base64"
                                },
                                "data": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "encoding",
                                "data"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "omitted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "bound",
                  "opened_for_writing",
                  "renamed",
                  "removed",
                  "unnamed",
                  "refused",
                  "refused_bound",
                  "paths",
                  "omitted"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "bound": {
                          "enum": [
                            "exact",
                            "at_least"
                          ]
                        }
                      },
                      "required": [
                        "bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "opened_for_writing": {
                          "type": "integer"
                        },
                        "renamed": {
                          "type": "integer"
                        },
                        "removed": {
                          "type": "integer"
                        },
                        "unnamed": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "bound": {
                          "not": {
                            "enum": [
                              "exact",
                              "at_least"
                            ]
                          }
                        }
                      },
                      "required": [
                        "bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "opened_for_writing": {
                          "type": "null"
                        },
                        "renamed": {
                          "type": "null"
                        },
                        "removed": {
                          "type": "null"
                        },
                        "unnamed": {
                          "type": "null"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "refused_bound": {
                          "enum": [
                            "exact",
                            "at_least"
                          ]
                        }
                      },
                      "required": [
                        "refused_bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "refused": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "refused_bound": {
                          "not": {
                            "enum": [
                              "exact",
                              "at_least"
                            ]
                          }
                        }
                      },
                      "required": [
                        "refused_bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "refused": {
                          "type": "null"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "bound": {
                          "not": {
                            "enum": [
                              "exact",
                              "at_least"
                            ]
                          }
                        }
                      },
                      "required": [
                        "bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "paths": {
                          "maxItems": 0
                        },
                        "omitted": {
                          "const": 0
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "line": {
                "const": "network"
              }
            },
            "required": [
              "line"
            ]
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "pending",
                      "none",
                      "proxy",
                      "host"
                    ]
                  },
                  "bound": {
                    "enum": [
                      "exact",
                      "at_least",
                      "not_observed",
                      "unavailable",
                      "disagree"
                    ]
                  },
                  "allowed": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "properties": {
                        "destination": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "results": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "connect_failed": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "destination",
                        "results",
                        "connect_failed"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "denied": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "properties": {
                        "destination": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "reason": {
                          "type": "string"
                        },
                        "results": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "destination",
                        "reason",
                        "results"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "omitted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "resolver_refused": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "mode",
                  "bound",
                  "allowed",
                  "denied",
                  "omitted",
                  "resolver_refused"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "bound": {
                          "not": {
                            "enum": [
                              "exact",
                              "at_least"
                            ]
                          }
                        }
                      },
                      "required": [
                        "bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "allowed": {
                          "maxItems": 0
                        },
                        "denied": {
                          "maxItems": 0
                        },
                        "omitted": {
                          "const": 0
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "line": {
                "const": "credentials"
              }
            },
            "required": [
              "line"
            ]
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "credentials": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "mode": {
                          "type": "string"
                        },
                        "never_staged": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "uses": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "uses_bound": {
                          "enum": [
                            "exact",
                            "at_least",
                            "not_observed",
                            "unavailable",
                            "disagree",
                            "not_recorded"
                          ]
                        },
                        "unconfirmed": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "transitions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "id",
                        "mode",
                        "never_staged",
                        "uses",
                        "uses_bound",
                        "unconfirmed",
                        "transitions"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "uses_bound": {
                                "enum": [
                                  "exact",
                                  "at_least"
                                ]
                              }
                            },
                            "required": [
                              "uses_bound"
                            ]
                          },
                          "then": {
                            "properties": {
                              "uses": {
                                "type": "integer"
                              },
                              "unconfirmed": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "uses_bound": {
                                "not": {
                                  "enum": [
                                    "exact",
                                    "at_least"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "uses_bound"
                            ]
                          },
                          "then": {
                            "properties": {
                              "uses": {
                                "type": "null"
                              },
                              "unconfirmed": {
                                "type": "null"
                              }
                            }
                          }
                        },
                        {
                          "$comment": "a use count with unconfirmed results is a lower bound",
                          "if": {
                            "properties": {
                              "unconfirmed": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "required": [
                              "unconfirmed"
                            ]
                          },
                          "then": {
                            "properties": {
                              "uses_bound": {
                                "const": "at_least"
                              }
                            }
                          }
                        }
                      ]
                    }
                  },
                  "omitted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "refusals": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "refusals_bound": {
                    "enum": [
                      "exact",
                      "at_least",
                      "not_observed",
                      "unavailable",
                      "disagree"
                    ]
                  }
                },
                "required": [
                  "credentials",
                  "omitted",
                  "refusals",
                  "refusals_bound"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "refusals_bound": {
                          "enum": [
                            "exact",
                            "at_least"
                          ]
                        }
                      },
                      "required": [
                        "refusals_bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "refusals": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "refusals_bound": {
                          "not": {
                            "enum": [
                              "exact",
                              "at_least"
                            ]
                          }
                        }
                      },
                      "required": [
                        "refusals_bound"
                      ]
                    },
                    "then": {
                      "properties": {
                        "refusals": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "line": {
                "const": "evidence"
              }
            },
            "required": [
              "line"
            ]
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "observe": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "attached": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "classes": {
                    "type": "object",
                    "properties": {
                      "exec": {
                        "enum": [
                          "supported",
                          "active",
                          "degraded",
                          "unsupported",
                          "unknown"
                        ]
                      },
                      "fs.write": {
                        "enum": [
                          "supported",
                          "active",
                          "degraded",
                          "unsupported",
                          "unknown"
                        ]
                      },
                      "fs.deny": {
                        "enum": [
                          "supported",
                          "active",
                          "degraded",
                          "unsupported",
                          "unknown"
                        ]
                      },
                      "net": {
                        "enum": [
                          "supported",
                          "active",
                          "degraded",
                          "unsupported",
                          "unknown"
                        ]
                      },
                      "proxy.net": {
                        "enum": [
                          "supported",
                          "active",
                          "degraded",
                          "unsupported",
                          "unknown"
                        ]
                      },
                      "limits": {
                        "enum": [
                          "supported",
                          "active",
                          "degraded",
                          "unsupported",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "exec",
                      "fs.write",
                      "fs.deny",
                      "net",
                      "proxy.net",
                      "limits"
                    ],
                    "additionalProperties": false
                  },
                  "gaps": {
                    "type": "array",
                    "items": {
                      "type": "object",
