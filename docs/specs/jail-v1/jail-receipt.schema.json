        }
      },
      "required": [
        "backend",
        "set",
        "attached",
        "sources",
        "gaps"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "exec": {
          "allOf": [
            {
              "$ref": "#/$defs/coverage"
            },
            {
              "properties": {
                "sources": {
                  "items": {
                    "const": "audit"
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        },
        "fs.write": {
          "allOf": [
            {
              "$ref": "#/$defs/coverage"
            },
            {
              "properties": {
                "sources": {
                  "items": {
                    "const": "audit"
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        },
        "fs.deny": {
          "allOf": [
            {
              "$ref": "#/$defs/coverage"
            },
            {
              "properties": {
                "sources": {
                  "items": {
                    "const": "audit"
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        },
        "net": {
          "allOf": [
            {
              "$ref": "#/$defs/coverage"
            },
            {
              "properties": {
                "sources": {
                  "items": {
                    "const": "audit"
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        },
        "limits": {
          "allOf": [
            {
              "$ref": "#/$defs/coverage"
            },
            {
              "properties": {
                "sources": {
                  "items": {
                    "const": "wrapper"
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        },
        "proxy.net": {
          "allOf": [
            {
              "$ref": "#/$defs/coverage"
            },
            {
              "properties": {
                "sources": {
                  "items": {
                    "const": "proxy"
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        }
      },
      "required": [
        "exec",
        "fs.write",
        "fs.deny",
        "net",
        "limits",
        "proxy.net"
      ],
      "additionalProperties": false
    },
    "process": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "identity": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "object"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "pid",
            "identity"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "lifetime": {
      "type": "object",
      "properties": {
        "boundary": {
          "enum": [
            "pending",
            "pid_namespace",
            "supervisor_cgroup",
            "native_tree"
          ]
        },
        "native": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "os": {
                  "enum": [
                    "linux",
                    "macos"
                  ]
                },
                "details": {
                  "type": "object"
                }
              },
              "required": [
                "os",
                "details"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "tree_empty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_scope": {
          "enum": [
            "attempt_tree",
            "registered_boundary",
            null
          ]
        },
        "integrity": {
          "enum": [
            "pending",
            "verified",
            "lost"
          ]
        }
      },
      "required": [
        "boundary",
        "native",
        "tree_empty",
        "verified_at",
        "verification_scope",
        "integrity"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "boundary": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "native": {
                "type": "null"
              },
              "verification_scope": {
                "type": "null"
              },
              "integrity": {
                "const": "pending"
              },
              "tree_empty": {
                "type": "null"
              },
              "verified_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tree_empty": {
                "type": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "integrity": {
                "const": "verified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tree_empty": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "verified_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "integrity": {
                "const": "lost"
              }
            }
          },
          "then": {
            "properties": {
              "tree_empty": {
                "type": "null"
              },
              "verified_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "boundary": {
                "not": {
                  "const": "pending"
                }
              }
            }
          },
          "then": {
            "properties": {
              "verification_scope": {
                "enum": [
                  "attempt_tree",
                  "registered_boundary"
                ]
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "pending",
            "refused",
            "exited",
            "signaled",
            "exec_error",
            "unknown"
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "code",
        "signal",
        "cause",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exited"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "signal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "signaled"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "signal": {
                "type": "integer",
                "minimum": 1
              },
              "code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pending"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "signal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "refused"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "signal": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "state_cleanup": {
      "enum": [
        "not_needed",
        "pending",
        "complete"
      ]
    },
    "cleanup_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      },
      "maxItems": 128
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "copy_rw",
              "bind_ro"
            ]
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "digest_unavailable_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "mode",
          "digest",
          "digest_unavailable_reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "digest": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "digest_unavailable_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "digest": {
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "digest_unavailable_reason": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "maxItems": 1024
    }
  },
  "required": [
    "schema",
    "attempt_id",
    "revision",
    "phase",
    "platform",
    "jail",
    "policy",
    "containment",
    "child_protection",
    "exec_observed",
    "argv_digest",
    "applied",
    "observer",
    "coverage",
    "process",
    "lifetime",
    "outcome",
    "state_cleanup",
    "cleanup_error",
    "created_at",
    "updated_at",
    "errors",
    "credentials"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:jail-receipt:1",
  "title": "Ouro jail receipt v1 (draft)",
  "description": "Draft shared shape and principal invariants. Native backend details and lifecycle ordering require the specification semantic tests.",
  "allOf": [
    {
      "if": {
        "properties": {
          "containment": {
            "const": "none"
          }
        },
        "required": [
          "containment"
        ]
      },
      "then": {
        "properties": {
          "child_protection": {
            "const": "unprotected"
          },
          "applied": {
            "properties": {
              "filesystem": {
                "type": "null"
              },
              "syscalls": {
                "type": "null"
              },
              "network": {
                "properties": {
                  "mode": {
                    "const": "host"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "containment": {
            "const": "enforced"
          }
        },
        "required": [
          "containment"
        ]
      },
      "then": {
        "properties": {
          "child_protection": {
            "const": "enforced"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "containment": {
            "const": "pending"
          }
        },
        "required": [
          "containment"
        ]
      },
      "then": {
        "properties": {
          "child_protection": {
            "const": "pending"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "settled"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "lifetime": {
            "properties": {
              "tree_empty": {
                "const": true
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "integrity": {
                "const": "verified"
              }
            }
          },
          "outcome": {
            "properties": {
              "kind": {
                "enum": [
                  "exited",
                  "signaled",
                  "unknown"
                ]
              }
            }
          },
          "containment": {
            "enum": [
              "enforced",
              "none"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "enforced"
          }
        },
        "required": [
          "phase"
