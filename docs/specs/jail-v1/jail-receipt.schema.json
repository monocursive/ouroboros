    },
    "argv_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "applied": {
      "type": "object",
      "properties": {
        "filesystem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mechanism": {
                  "type": "string"
                },
                "protected_coverage": {
                  "enum": [
                    "existing_and_root",
                    "all_descendants",
                    "none"
                  ]
                },
                "mounts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "$ref": "#/$defs/native_string"
                      },
                      "mode": {
                        "enum": [
                          "rw",
                          "ro",
                          "hidden"
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "mode"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 1024
                }
              },
              "required": [
                "mechanism",
                "protected_coverage",
                "mounts"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
