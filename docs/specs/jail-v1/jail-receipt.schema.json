              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "allowed_hosts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 1024
            }
          },
          "required": [
            "mode",
            "mechanism",
            "allowed_hosts"
          ],
          "additionalProperties": false
        },
        "syscalls": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mechanism": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "mechanism",
                "digest"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "enum": [
                  "wall",
                  "pids",
                  "mem",
                  "cpu"
                ]
              },
              "requested": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "applied": {
                "type": "boolean"
              },
              "mechanism": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scope": {
                "enum": [
                  "process",
                  "tree",
                  null
                ]
              },
              "hit": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key",
              "requested",
              "required",
              "applied",
              "mechanism",
              "scope",
              "hit"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "applied": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "mechanism": {
                      "type": "null"
                    },
                    "scope": {
                      "type": "null"
                    },
                    "hit": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "applied": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "mechanism": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "enum": [
                        "tree",
                        "process"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 4
        },
        "environment_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1024
        },
        "removed_environment_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1024
        }
      },
      "required": [
        "filesystem",
        "network",
        "syscalls",
        "limits",
        "environment_names",
        "removed_environment_names"
      ],
      "additionalProperties": false
    },
    "observer": {
      "type": "object",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attached": {
          "type": "boolean"
        },
        "sources": {
          "type": "object",
          "properties": {
            "wrapper": {
              "enum": [
                "supported",
                "active",
                "degraded",
                "unsupported"
              ]
            },
            "audit": {
              "enum": [
                "supported",
                "active",
                "degraded",
                "unsupported"
              ]
            },
            "proxy": {
              "enum": [
                "supported",
                "active",
                "degraded",
                "unsupported"
              ]
            }
          },
          "required": [
            "wrapper",
            "audit",
            "proxy"
          ],
          "additionalProperties": false
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
