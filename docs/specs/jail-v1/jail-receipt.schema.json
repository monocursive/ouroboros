        },
        "kernel": {
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch",
        "kernel"
      ],
      "additionalProperties": false
    },
    "jail": {
      "type": "object",
      "properties": {
        "component": {
          "const": "ouro-jail"
        },
        "version": {
          "type": "string"
        },
        "backend": {
