            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/native_string"
              },
              "by": {
                "const": "operator"
              }
            },
            "required": [
              "kind",
              "value",
              "by"
            ],
            "additionalProperties": false
          },
          "maxItems": 1024
        }
      },
      "required": [
        "name",
        "digest",
        "observe",
        "evidence",
        "requirements",
        "grants"
      ],
      "additionalProperties": false
