{
  "type": "object",
  "properties": {
    "schema": {
      "const": "ouro.event/1"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source": {
      "enum": [
        "wrapper",
        "audit",
        "proxy"
      ]
    },
    "source_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "operation": {
      "enum": [
        "proc.exec",
        "proc.exit",
        "fs.create",
        "fs.write",
        "fs.rename",
        "fs.unlink",
        "fs.deny",
        "net.connect",
        "net.dns",
        "limit.hit",
        "jail.receipt",
        "intent.admitted",
        "intent.denied",
        "intent.settled",
        "note"
      ]
    },
    "stage": {
      "enum": [
        "attempt",
        "result"
      ]
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        null
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "not": {
          "enum": [
            "raw_argv",
            "raw_environment",
            "credential_contents"
          ]
        }
      }
    }
  },
  "required": [
    "schema",
    "attempt_id",
    "source",
    "source_seq",
    "observed_at",
    "monotonic_ns",
    "operation",
    "stage",
    "decision",
    "outcome",
    "fields"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:event:1",
  "title": "Ouro source event v1 (draft)",
  "description": "Draft envelope. Source-specific semantics, field redaction and payload byte bounds also require the jail specification tests.",
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "attempt"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "result"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "audit"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "proc.exec",
              "proc.exit",
              "fs.create",
              "fs.write",
              "fs.rename",
              "fs.unlink",
              "fs.deny",
              "net.connect"
            ]
          },
          "decision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "proxy"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "net.connect",
              "net.dns"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "fs.deny"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "result"
          },
          "outcome": {
            "properties": {
              "ok": {
                "const": false
              },
              "errno": {
                "enum": [
                  "EACCES",
                  "EPERM"
                ]
              }
            },
            "required": [
              "ok",
              "errno"
            ]
          },
          "fields": {
            "properties": {
              "attempted_operation": {
                "enum": [
                  "proc.exec",
                  "fs.create",
                  "fs.write",
                  "fs.rename",
                  "fs.unlink",
                  "net.connect"
                ]
              }
            },
            "required": [
              "attempted_operation"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "outcome": {
      "type": "object",
      "properties": {
        "ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "return_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion": {
          "enum": [
            "syscall_return",
            "exec_transition",
            "process_exit",
            "proxy_close",
            "wrapper"
          ]
        },
        "bytes_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes_out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ok",
        "completion"
      ],
      "additionalProperties": false
    }
  }
}
