{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-bundle:2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ouro.ledger.bundle/2"
    },
    "authenticity": {
      "const": "signed"
    },
    "capture_digest_basis": {
      "const": "bundle_time"
    },
    "run": {
      "$ref": "urn:ouro:schema:ledger-run:1",
      "properties": {
        "chain": {
          "properties": {
            "head_seq": {
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "events.ndjson",
              "receipts.json",
              "stdout.bin",
              "stderr.bin"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "bytes",
          "digest"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "const": "receipts.json"
                }
              }
            },
            "then": {
              "properties": {
                "bytes": {
                  "maximum": 4194304
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "enum": [
                    "stdout.bin",
                    "stderr.bin"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "bytes": {
                  "maximum": 16777216
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "events.ndjson"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "receipts.json"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "stdout.bin"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "stderr.bin"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  },
  "required": [
    "schema",
    "authenticity",
    "capture_digest_basis",
    "run",
    "files"
  ],
  "additionalProperties": false
}
