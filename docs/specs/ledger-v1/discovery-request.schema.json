{
  "type": "object",
  "properties": {
    "runs": {
      "$ref": "urn:ouro:schema:ledger-catalog-request:1#/$defs/filter"
    },
    "filter": {
      "type": "object",
      "properties": {
        "selector": {
          "enum": [
            "execs",
            "paths",
            "hosts",
            "denials"
          ]
        },
        "stage": {
          "enum": [
            "attempt",
            "result",
            null
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "required": [
        "selector",
        "stage",
        "since",
        "until"
      ],
      "additionalProperties": false
    },
    "after": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "required": [
    "runs",
    "filter",
    "after",
    "limit"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-discovery-request:1",
  "title": "Filtered cross-run evidence request"
}
