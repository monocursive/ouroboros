{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-gc-anchor:1",
  "title": "Whole-run pruning authority; JCS checksum covers retained, not this envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest",
    "retained"
  ],
  "properties": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run",
        "manifest",
        "replay",
        "strict_source_loss",
        "last_activity_at",
        "collected_at",
        "cutoff",
        "retain_days",
        "operator",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "ouro.ledger.gc-anchor/1"
        },
        "run": {
          "allOf": [
            {
              "$ref": "urn:ouro:schema:ledger-run:1"
            },
            {
              "properties": {
                "state": {
                  "enum": [
                    "settled",
                    "denied"
                  ]
                },
                "settlement": {
                  "const": "recorded"
                },
                "holds": {
                  "maxItems": 0
                }
              },
              "not": {
                "required": [
                  "history"
                ]
              }
            }
          ]
        },
        "manifest": {
          "$ref": "https://ouroboros.monocursive.com/schemas/ledger-v1/segments"
        },
        "replay": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 65536,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "digest",
              "receipt"
            ],
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seq",
                  "digest"
                ],
                "properties": {
                  "seq": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 18446744073709551615
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "strict_source_loss": {
          "type": "boolean"
        },
        "last_activity_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "cutoff": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "retain_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        "operator": {
          "type": "object",
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "birth": {
              "type": "string",
              "minLength": 1
            },
            "boot_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "uid",
            "pid",
            "birth",
            "boot_id"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4099,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "digest",
              "device",
              "inode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(events-[0-9]{4}\\.ndjson|artifacts/(stdout|stderr|argv)\\.bin)$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1073741824
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "device": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "inode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "path": {
                      "pattern": "^artifacts/"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16777216
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
