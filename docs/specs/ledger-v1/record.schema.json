{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-record:1",
  "title": "Canonical durable ledger record",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "prev": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "operator",
                "owner"
              ]
            },
            "peer_uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "peer_pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "peer_birth": {
              "type": "string",
              "minLength": 1
            },
            "token_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              ]
            }
          },
          "required": [
            "role",
            "peer_uid",
            "peer_pid",
            "peer_birth",
            "token_id"
          ],
          "additionalProperties": false
        },
        "kind": {
          "enum": [
            "prepared",
            "owner_claimed",
            "admitted",
            "denied",
            "settled",
            "note",
            "outcome_unknown",
            "hold",
            "release",
            "operator_intent"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 136,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "schema": {
          "const": "ouro.ledger.event/1"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "body": {
          "type": "object"
        },
        "effect_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "seq",
        "prev",
        "received_at",
        "provenance",
        "kind",
        "request_id",
        "schema",
        "attempt_id",
        "body"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "prepared"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "role": {
                    "const": "operator"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "owner_claimed",
                  "admitted",
                  "denied",
                  "settled",
                  "note"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "role": {
                    "const": "owner"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "settled"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "body": {
                "properties": {
                  "receipt": {
                    "$ref": "#/$defs/settled_receipt"
                  }
                },
                "required": [
                  "receipt"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "hold",
                  "release"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "role": {
                    "const": "operator"
                  },
                  "token_id": {
                    "type": "null"
                  }
                }
              },
              "body": {
                "type": "object",
                "maxProperties": 0
              }
            },
            "not": {
              "required": [
                "effect_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "operator_intent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "role": {
                    "const": "operator"
                  },
                  "token_id": {
                    "type": "null"
                  }
                }
              },
              "body": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "admitted",
                      "denied",
                      "settled",
                      "note"
                    ]
                  },
                  "fields": {
                    "type": "object",
                    "propertyNames": {
                      "not": {
                        "enum": [
                          "actor",
                          "role",
                          "provenance",
                          "run_id",
                          "attempt_id",
                          "seq",
                          "prev",
                          "received_at",
                          "token_id"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "kind",
                  "fields"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "effect_id"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "body": {
                      "properties": {
                        "kind": {
                          "enum": [
                            "admitted",
                            "denied",
                            "settled"
                          ]
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "effect_id": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "$ref": "urn:ouro:schema:ledger-source:1"
    }
  ],
  "$defs": {
    "settled_receipt": {
      "description": "A normal settled jail receipt or a proved exec failure after durable ledger admission. Neither denotes success by itself.",
      "allOf": [
        {
          "$ref": "urn:ouro:schema:jail-receipt:1"
        },
        {
          "anyOf": [
            {
              "properties": {
                "phase": {
                  "const": "settled"
                }
              },
              "required": [
                "phase"
              ]
            },
            {
              "properties": {
                "phase": {
                  "const": "refused"
                },
                "outcome": {
                  "properties": {
                    "kind": {
                      "const": "exec_error"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "exec_observed": {
                  "const": false
                },
                "lifetime": {
                  "properties": {
                    "tree_empty": {
                      "const": true
                    },
                    "integrity": {
                      "const": "verified"
                    },
                    "verification_scope": {
                      "const": "attempt_tree"
                    }
                  },
                  "required": [
                    "tree_empty",
                    "integrity",
                    "verification_scope"
                  ]
                }
              },
              "required": [
                "phase",
                "outcome",
                "exec_observed",
                "lifetime"
              ]
            }
          ]
        }
      ]
    }
  }
}
