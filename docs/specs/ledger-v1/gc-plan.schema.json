{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-gc-plan:1",
  "title": "Non-destructive retention preview, not deletion authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dry_run",
    "deletion_supported",
    "verification_required",
    "retain_days",
    "evaluated_at",
    "cutoff",
    "runs",
    "next_after"
  ],
  "properties": {
    "schema": {
      "const": "ouro.ledger.gc-plan/1"
    },
    "dry_run": {
      "const": true
    },
    "deletion_supported": {
      "const": true
    },
    "verification_required": {
      "const": true
    },
    "retain_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36500
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "runs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "state",
          "child_protection",
          "chain",
          "last_activity_at",
          "candidate",
          "keep_reasons"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^run_[0-9a-f]{32}$"
          },
          "state": {
            "enum": [
              "prepared",
              "admitted",
              "denied",
              "settled",
              "outcome_unknown"
            ],
            "description": "Settled means a durably recorded terminal result after admission, including a proved exec_error; it does not imply success. Denied is a refusal before ledger admission."
          },
          "child_protection": {
            "enum": [
              "enforced",
              "unprotected"
            ]
          },
          "chain": {
            "type": "object",
            "properties": {
              "head_seq": {
                "type": "integer",
                "minimum": 0
              },
              "head_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "head_seq",
              "head_digest"
            ],
            "additionalProperties": false
          },
          "last_activity_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate": {
            "type": "boolean"
          },
          "keep_reasons": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 12,
            "items": {
              "enum": [
                "poisoned_stream",
                "outcome_unknown",
                "active_run",
                "settlement_pending",
                "operator_hold",
                "activity_time_unknown",
                "clock_before_activity",
                "retention_window",
                "reader_checkpoint_unknown",
                "reader_snapshot",
                "canonical_layout_changed",
                "history_pruned"
              ]
            }
          }
        },
        "if": {
          "properties": {
            "candidate": {
              "const": true
            }
          }
        },
        "then": {
          "properties": {
            "keep_reasons": {
              "maxItems": 0
            }
          }
        },
        "else": {
          "properties": {
            "keep_reasons": {
              "minItems": 1
            }
          }
        }
      }
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
