{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouroboros.monocursive.com/schemas/ledger-v1/segments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "attempt_id",
    "replay_digest"
  ],
  "properties": {
    "schema": {
      "enum": [
        "ouro.ledger.segments/1",
        "ouro.ledger.segments/2"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-9a-f-]{36}$"
    },
    "replay_digest": {
      "$ref": "#/$defs/digest"
    },
    "segment": {
      "$ref": "#/$defs/segment"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "first_seq",
        "last_seq",
        "bytes",
        "digest",
        "head_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^events-[0-9]{4}\\.ndjson$"
        },
        "first_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "last_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "head_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema": {
          "const": "ouro.ledger.segments/1"
        },
        "segment": {
          "properties": {
            "name": {
              "const": "events-0001.ndjson"
            },
            "first_seq": {
              "const": 1
            }
          }
        }
      },
      "required": [
        "segment"
      ],
      "not": {
        "required": [
          "segments"
        ]
      }
    },
    {
      "properties": {
        "schema": {
          "const": "ouro.ledger.segments/2"
        }
      },
      "required": [
        "segments"
      ],
      "not": {
        "required": [
          "segment"
        ]
      }
    }
  ]
}
