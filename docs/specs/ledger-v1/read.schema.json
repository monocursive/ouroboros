{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-read:1",
  "title": "Bounded local evidence reader page; not a custody assertion",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ouro.ledger.read/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "snapshot": {
      "$ref": "#/$defs/chain"
    },
    "state": {
      "enum": [
        "prepared",
        "admitted",
        "denied",
        "settled",
        "outcome_unknown"
      ]
    },
    "child_protection": {
      "enum": [
        "enforced",
        "unprotected"
      ]
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "local_consistency": {
      "type": "boolean"
    },
    "stream_status": {
      "enum": [
        "complete",
        "active",
        "incomplete",
        "corrupt"
      ]
    },
    "problems": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "scanned_through_seq": {
      "type": "integer",
      "minimum": 0
    },
    "done": {
      "type": "boolean"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "urn:ouro:schema:ledger-record:1"
      }
    },
    "ndjson": {
      "type": "string",
      "maxLength": 65536
    },
    "oversized_record": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 131073,
              "maximum": 1048575
            }
          },
          "required": [
            "seq",
            "bytes"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "run_id",
    "snapshot",
    "state",
    "child_protection",
    "coverage",
    "local_consistency",
    "stream_status",
    "problems",
    "scanned_through_seq",
    "done",
    "next_cursor",
    "records",
    "ndjson",
    "oversized_record"
  ],
  "additionalProperties": false,
  "$defs": {
    "chain": {
      "type": "object",
      "properties": {
        "head_seq": {
          "type": "integer",
          "minimum": 0
        },
        "head_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "head_seq",
        "head_digest"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "snapshot_run"
        },
        "status": {
          "type": "string",
          "maxLength": 32
        },
        "classes": {
          "type": "object",
          "maxProperties": 7,
          "propertyNames": {
            "enum": [
              "exec",
              "fs.write",
              "fs.deny",
              "net",
              "limits",
              "proxy.net",
              "ledger"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "maxLength": 32
              },
              "sources": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "observed_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "gap_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "status",
              "sources",
              "observed_count",
              "gap_count"
            ],
            "additionalProperties": false
          }
        },
        "gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "selection_status": {
          "enum": [
            "active",
            "degraded",
            "unobserved"
          ]
        }
      },
      "required": [
        "scope",
        "status",
        "classes",
        "gap_count",
        "selection_status"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "done": {
            "const": true
          }
        },
        "required": [
          "done"
        ]
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "null"
          }
        }
      }
    },
    {
      "anyOf": [
        {
          "properties": {
            "records": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "ndjson": {
              "maxLength": 0
            }
          }
        }
      ]
    }
  ]
}
