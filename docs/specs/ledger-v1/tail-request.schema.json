{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-tail-request:1",
  "title": "Resumable byte position in one canonical stream",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  },
  "required": [
    "run_id",
    "cursor"
  ],
  "additionalProperties": false
}
