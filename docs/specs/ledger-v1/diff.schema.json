{
  "type": "object",
  "properties": {
    "schema": {
      "const": "ouro.ledger.diff/1"
    },
    "mode": {
      "enum": [
        "event_counts",
        "target_counts"
      ]
    },
    "comparison_status": {
      "enum": [
        "comparable",
        "partial",
        "incomparable"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "left": {
      "$ref": "#/$defs/summary"
    },
    "right": {
      "$ref": "#/$defs/summary"
    },
    "classes": {
      "type": "object",
      "properties": {
        "exec": {
          "$ref": "#/$defs/classification"
        },
        "fs.write": {
          "$ref": "#/$defs/classification"
        },
        "fs.deny": {
          "$ref": "#/$defs/classification"
        },
        "net": {
          "$ref": "#/$defs/classification"
        },
        "proxy.net": {
          "$ref": "#/$defs/classification"
        },
        "limits": {
          "$ref": "#/$defs/classification"
        }
      },
      "required": [
        "exec",
        "fs.write",
        "fs.deny",
        "net",
        "proxy.net",
        "limits"
      ],
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "observation": {
            "type": "object",
            "properties": {
              "class": {
                "enum": [
                  "exec",
                  "fs.write",
                  "fs.deny",
                  "net",
                  "proxy.net",
                  "limits"
                ]
              },
              "source": {
                "enum": [
                  "wrapper",
                  "audit",
                  "proxy"
                ]
              },
              "operation": {
                "enum": [
                  "proc.exec",
                  "proc.exit",
                  "fs.create",
                  "fs.write",
                  "fs.rename",
                  "fs.unlink",
                  "fs.deny",
                  "net.connect",
                  "net.dns",
                  "limit.hit",
                  "jail.receipt",
                  "intent.admitted",
                  "intent.denied",
                  "intent.settled",
                  "note"
                ]
              },
              "stage": {
                "enum": [
                  "attempt",
                  "result"
                ]
              },
              "decision": {
                "enum": [
                  "allow",
                  "deny",
                  null
                ]
              },
              "outcome": {
                "anyOf": [
                  {
                    "$ref": "urn:ouro:schema:ledger-source:1#/$defs/outcome"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target": {
                "$ref": "#/$defs/target"
              }
            },
            "required": [
              "class",
              "source",
              "operation",
              "stage",
              "decision",
              "outcome"
            ],
            "additionalProperties": false
          },
          "left_count": {
            "type": "integer",
            "minimum": 0
          },
          "right_count": {
            "type": "integer",
            "minimum": 0
          },
          "left_first_record": {
            "$ref": "#/$defs/reference"
          },
          "right_first_record": {
            "$ref": "#/$defs/reference"
          }
        },
        "required": [
          "observation",
          "left_count",
          "right_count",
          "left_first_record",
          "right_first_record"
        ],
        "additionalProperties": false
      }
    },
    "total_changes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "target_scope": {
      "const": {
        "identity": "recorded_labels",
        "exec": [
          "proc.exec"
        ],
        "fs.write": [
          "fs.create",
          "fs.write",
          "fs.rename",
          "fs.unlink"
        ],
        "fs.deny": [
          "fs.deny"
        ],
        "proxy.net": [
          "net.connect",
          "net.dns"
        ]
      }
    }
  },
  "required": [
    "schema",
    "mode",
    "comparison_status",
    "complete",
    "left",
    "right",
    "classes",
    "changes",
    "total_changes",
    "next_after"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouro:schema:ledger-diff:1",
  "title": "Bounded comparison of covered event counts or recorded target labels",
  "$defs": {
    "summary": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "urn:ouro:schema:ledger-read:1#/$defs/chain"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "prepared",
            "admitted",
            "denied",
            "settled",
            "outcome_unknown",
            "unknown"
          ]
        },
        "child_protection": {
          "enum": [
            "enforced",
            "unprotected",
            "unknown"
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "urn:ouro:schema:ledger-read:1#/$defs/coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_consistency": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable_targets": {
          "type": "object",
          "properties": {
            "exec": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "first_record": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "provenance": {
                      "$ref": "urn:ouro:schema:ledger-source:1#/properties/provenance"
                    }
                  },
                  "required": [
                    "seq",
                    "provenance"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "count",
                "first_record"
              ],
              "additionalProperties": false
            },
            "fs.write": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "first_record": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "provenance": {
                      "$ref": "urn:ouro:schema:ledger-source:1#/properties/provenance"
                    }
                  },
                  "required": [
                    "seq",
                    "provenance"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "count",
                "first_record"
              ],
              "additionalProperties": false
            },
            "fs.deny": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "first_record": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "provenance": {
                      "$ref": "urn:ouro:schema:ledger-source:1#/properties/provenance"
                    }
                  },
                  "required": [
                    "seq",
                    "provenance"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "count",
                "first_record"
              ],
              "additionalProperties": false
            },
            "proxy.net": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "first_record": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "provenance": {
                      "$ref": "urn:ouro:schema:ledger-source:1#/properties/provenance"
                    }
                  },
                  "required": [
                    "seq",
                    "provenance"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "count",
                "first_record"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "snapshot",
        "state",
        "child_protection",
        "coverage",
        "local_consistency",
        "complete",
        "problem"
      ],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "comparable",
            "incomparable"
          ]
        },
        "left_reason": {
          "anyOf": [
            {
              "enum": [
                "incomplete_evidence",
                "run_not_terminal",
                "coverage_degraded",
                "unobserved",
                "source_unspecified",
                "target_comparison_unsupported",
                "target_identity_unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "right_reason": {
          "anyOf": [
            {
              "enum": [
                "incomplete_evidence",
                "run_not_terminal",
                "coverage_degraded",
                "unobserved",
                "source_unspecified",
                "target_comparison_unsupported",
                "target_identity_unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "shared_reason": {
          "anyOf": [
            {
              "const": "source_set_mismatch"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "left_reason",
        "right_reason",
        "shared_reason"
      ],
      "additionalProperties": false
    },
    "reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "provenance": {
              "$ref": "urn:ouro:schema:ledger-source:1#/properties/provenance"
            }
          },
          "required": [
            "seq",
            "provenance"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "path"
            },
            "path_basis": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "allOf": [
                {
                  "$ref": "urn:ouro:schema:ledger-source:1#/$defs/path"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "workspace_relative",
                        "scratch_relative",
                        "digest"
                      ]
                    }
                  }
                }
              ]
            },
            "path2": {
              "allOf": [
                {
                  "$ref": "urn:ouro:schema:ledger-source:1#/$defs/path"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "workspace_relative",
                        "scratch_relative",
                        "digest"
                      ]
                    }
                  }
                }
              ]
            },
            "action": {},
            "attempted_operation": {}
          },
          "required": [
            "kind",
            "path_basis",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "proxy_destination"
            },
            "destination": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "destination"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "target_counts"
          }
        }
      },
      "then": {
        "required": [
          "target_scope"
        ],
        "properties": {
          "left": {
            "required": [
              "unavailable_targets"
            ]
          },
          "right": {
            "required": [
              "unavailable_targets"
            ]
          },
          "changes": {
            "items": {
              "properties": {
                "observation": {
                  "required": [
                    "target"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "target_scope"
          ]
        },
        "properties": {
          "changes": {
            "items": {
              "properties": {
                "observation": {
                  "not": {
                    "required": [
                      "target"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
